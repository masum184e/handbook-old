gs":[]},"outputs":[{"data":{"text/plain":["array([[0.81649658, 0.        , 0.        ]])"]},"execution_count":23,"metadata":{},"output_type":"execute_result"}],"source":["# Calculate cosine similarity\n","similarities = cosine_similarity(\n","    query_vector,\n","    tfidf_matrix\n",")\n","similarities"]},{"cell_type":"code","execution_count":24,"id":"551fafd0","metadata":{"execution":{"iopub.execute_input":"2026-11-13T06:32:27.125999Z","iopub.status.busy":"2026-11-13T06:32:27.125124Z","iopub.status.idle":"2026-11-13T06:32:27.13121Z","shell.execute_reply":"2026-11-13T06:32:27.130424Z"},"papermill":{"duration":0.028231,"end_time":"2026-11-13T06:32:27.132944+00:00","exception":false,"start_time":"2026-11-13T06:32:27.104713+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["array([0.81649658, 0.        , 0.        ])"]},"execution_count":24,"metadata":{},"output_type":"execute_result"}],"source":["# Display search results\n","scores = similarities.flatten()\n","scores"]},{"cell_type":"code","execution_count":25,"id":"55613eed","metadata":{"execution":{"iopub.execute_input":"2026-11-13T06:32:27.172464Z","iopub.status.busy":"2026-11-13T06:32:27.171715Z","iopub.status.idle":"2026-11-13T06:32:27.177498Z","shell.execute_reply":"2026-11-13T06:32:27.176748Z"},"papermill":{"duration":0.027301,"end_time":"2026-11-13T06:32:27.179071+00:00","exception":false,"start_time":"2026-11-13T06:32:27.15177+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["array([0, 2, 1])"]},"execution_count":25,"metadata":{},"output_type":"execute_result"}],"source":["ranked_indices = scores.argsort()[::-1]\n","ranked_indices"]},{"cell_type":"code","execution_count":26,"id":"6c39ed68","metadata":{"execution":{"iopub.execute_input":"2026-11-13T06:32:27.218004Z","iopub.status.busy":"2026-11-13T06:32:27.217217Z","iopub.status.idle":"2026-11-13T06:32:27.222423Z","shell.execute_reply":"2026-11-13T06:32:27.221503Z"},"papermill":{"duration":0.026463,"end_time":"2026-11-13T06:32:27.22406+00:00","exception":false,"start_time":"2026-11-13T06:32:27.197597+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["I love machine learning Score: 0.816496580927726\n","I like eating pizza Score: 0.0\n","I enjoy coding Score: 0.0\n"]}],"source":["for index in ranked_indices:\n","    print(\n","        sentences1[index],\n","        \"Score:\",\n","        scores[index]\n","    )"]},{"cell_type":"markdown","id":"dc64510b","metadata":{"papermill":{"duration":0.018501,"end_time":"2026-11-13T06:32:27.260941+00:00","exception":false,"start_time":"2026-11-13T06:32:27.24244+00:00","status":"completed"},"tags":[]},"source":["You might wonder: If TF IDF already calculates word importance, why do we need cosine similarity?\n","\n","Because they perform two different jobs:\n","\n","| TF IDF | Cosine Similarity |\n","| --- | --- |\n","| Calculates word importance | Measures vector similarity |\n","| Converts text into vectors | Compares vectors |\n","| Generates numerical representations | Generates similarity scores |\n","\n","## BM25 (Best Matching 25)\n","\n","BM25 is a ranking algorithm widely used in modern search engines and hybrid retrieval systems.\n","\n","It improves upon traditional TF IDF by considering:\n","\n","1. Term frequency.\n","2. Inverse document frequency.\n","3. Document length normalization.\n","4. Term frequency saturation.\n","\n","The BM25 formula is:\n","\n","$$\n","\\begin{aligned}\n","BM25(D,Q)=\\sum_{t\\in Q}&IDF(t)\\\\\n","&\\times\n","\\frac{f(t,D)(k_1+1)}\n","{f(t,D)+k_1(1-b+b\\frac{|D|}{avgdl})}\n","\\end{aligned}\n","$$\n","\n","Where:\n","\n","| Parameter | Meaning |\n","| --- | --- |\n","| $D$ | Document |\n","| $Q$ | Search query |\n","| $f(t,D)$ | Frequency of term in document |\n","| $IDF(t)$ | Inverse document frequency |\n","| $\\|D\\|$ | Document length |\n","| $avgdl$ | Average document length |\n","| $k_1$ | Controls term frequency saturation |\n","| $b$ | Controls document length normalization |\n","\n","Typical values are:\n","\n","- $k_1 = 1.2$ to $2.0$\n","- $b = 0.75$\n","\n","### Why BM25 is better than basic TF IDF\n","\n","Imagine two documents:\n","\n","- D1: `Vector database` (2 words)\n","- D2: `Vector database` repeated 50 times in a long document.\n","\n","A basic term frequency approach might give D2 an excessively high score because the query terms appear many times.\n","\n","BM25 uses term frequency saturation, meaning that repeating a term 50 times does not necessarily make the document 50 times more relevant.\n","\n","It also normalizes for document length, helping avoid unfairly favoring longer documents.\n","\n","In vector databases: BM25 is particularly useful for retrieving documents that contain exact keywords, technical terms, product names, identifiers, or specific phrases."]},{"cell_type":"code","execution_count":27,"id":"6a79e1ce","metadata":{"execution":{"iopub.execute_input":"2026-11-13T06:32:27.301372Z","iopub.status.busy":"2026-11-13T06:32:27.300446Z","iopub.status.idle":"2026-11-13T06:32:29.706769Z","shell.execute_reply":"2026-11-13T06:32:29.705433Z"},"papermill":{"duration":2.429164,"end_time":"2026-11-13T06:32:29.708811+00:00","exception":false,"start_time":"2026-11-13T06:32:27.279647+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Collecting rank-bm25\r\n","  Downloading rank_bm25-0.2.2-py3-none-any.whl.metadata (3.2 kB)\r\n","Requirement already satisfied: numpy in /usr/local/lib/python3.13/dist-packages (from rank-bm25) (2.1.3)\r\n","Downloading rank_bm25-0.2.2-py3-none-any.whl (8.6 kB)\r\n","Installing collected packages: rank-bm25\r\n","Successfully installed rank-bm25-0.2.2\r\n","Note: you may need to restart the kernel to use updated packages.\n"]}],"source":["pip install rank-bm25"]},{"cell_type":"code","execution_count":28,"id":"843f2cef","metadata":{"execution":{"iopub.execute_input":"2026-11-13T06:32:29.74932Z","iopub.statu