:"2026-11-01T07:23:08.004036Z"},"papermill":{"duration":0.038068,"end_time":"2026-11-01T07:23:08.007141+00:00","exception":false,"start_time":"2026-11-01T07:23:07.969073+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[[1.         0.7258661  0.07632804]\n"," [0.7258661  1.0000001  0.0169613 ]\n"," [0.07632804 0.0169613  1.        ]]\n"]}],"source":["sentences2 = [\n","    \"How can I develop an AI application?\",\n","    \"How do I build an artificial intelligence system?\",\n","    \"What is the capital of Bangladesh?\",\n","]\n","\n","# Generate embeddings\n","embeddings2 = model.encode(sentences2)\n","\n","# Calculate cosine similarity\n","similarity2 = cosine_similarity(embeddings2)\n","\n","print(similarity2)"]},{"cell_type":"code","execution_count":12,"id":"1472e823","metadata":{"execution":{"iopub.execute_input":"2026-11-01T07:23:08.019058Z","iopub.status.busy":"2026-11-01T07:23:08.01824Z","iopub.status.idle":"2026-11-01T07:23:08.025129Z","shell.execute_reply":"2026-11-01T07:23:08.023807Z"},"papermill":{"duration":0.014984,"end_time":"2026-11-01T07:23:08.027076+00:00","exception":false,"start_time":"2026-11-01T07:23:08.012092+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["How can I develop an AI application?  <->  How do I build an artificial intelligence system? = 0.7258661\n","How can I develop an AI application?  <->  What is the capital of Bangladesh? = 0.07632804\n","How do I build an artificial intelligence system?  <->  What is the capital of Bangladesh? = 0.016961299\n"]}],"source":["# similar sentences\n","\n","for i in range(len(sentences2)):\n","    for j in range(i + 1, len(sentences2)):\n","        print(\n","            sentences2[i],\n","            \" <-> \",\n","            sentences2[j],\n","            \"=\",\n","            similarity2[i][j]\n","        )"]},{"cell_type":"markdown","id":"a1c87197","metadata":{"papermill":{"duration":0.004846,"end_time":"2026-11-01T07:23:08.03681+00:00","exception":false,"start_time":"2026-11-01T07:23:08.031964+00:00","status":"completed"},"tags":[]},"source":["# Vector Database\n","\n","When you generate embeddings, you typically store them in a database along with the original sentence.\n","\n","Each sentence gets converted into a numerical vector by your embedding model.\n","\n","## What exactly does a vector database store?\n","\n","A vector database typically stores more than just vectors.\n","\n","It stores three important things:\n","\n","1. Vector embeddings.\n","2. Original data or a reference to the original data.\n","3. Metadata.\n","\n","For example, imagine you are building a RAG application for technical documentation.\n","\n","A record might look like this:\n","\n","```py\n","{\n","    \"id\": \"doc_001\",\n","    \"text\": \"FastAPI is a Python web framework.\",\n","    \"embedding\": [\n","        0.21,\n","        0.45,\n","        0.78,\n","        0.12\n","    ],\n","    \"metadata\": {\n","        \"source\": \"fastapi_documentation.pdf\",\n","        \"page\": 12,\n","        \"category\": \"programming\",\n","        \"author\": \"OpenAI\"\n","    }\n","}\n","```\n","\n","Let's understand each field.\n","\n","| Field     | Purpose                              |\n","| --------- | ------------------------------------ |\n","| ID        | Uniquely identifies a record         |\n","| Text      | Original content                     |\n","| Embedding | Numerical representation             |\n","| Metadata  | Additional information for filtering |\n","\n","**Why store metadata?**\n","\n","Imagine a user asks:\n","\n","> Explain FastAPI authentication from the official documentation.\n","\n","You can search semantically while filtering:\n","\n","```py\n","filter = {    \n","    \"category\": \"programming\",\n","    \"source\": \"fastapi_documentation.pdf\"\n","}\n","```\n","\n","This allows you to combine semantic search with traditional filtering.\n","\n","## How data looks in a database\n","\n","| id | sentence | embedding | metadata |\n","|---|---|---|---|\n","| 1 | I love machine learning | `[0.21, 0.45, 0.78, ...]` | `{\"category\": \"AI\", \"source\": \"doc1.pdf\"}` |\n","| 2 | Python is a programming language | `[0.32, 0.12, 0.89, ...]` | `{\"category\": \"programming\", \"source\": \"doc2.pdf\"}` |\n","| 3 | Artificial intelligence is fascinating | `[0.56, 0.23, 0.67, ...]` | `{\"category\": \"AI\", \"source\": \"doc3.pdf\"}` |\n","\n","The embedding column stores the entire vector (for example, 384 floating-point values), not just the first and last five values.\n","\n","## Embeddings using SQLite\n","\n","### Store Embeddings\n","\n","SQLite is a simple database that you can use to understand how embedding storage works."]},{"cell_type":"code","execution_count":13,"id":"8d4a0117","metadata":{"execution":{"iopub.execute_input":"2026-11-01T07:23:08.04808Z","iopub.status.busy":"2026-11-01T07:23:08.047725Z","iopub.status.idle":"2026-11-01T07:23:08.115919Z","shell.execute_reply":"2026-11-01T07:23:08.114852Z"},"papermill":{"duration":0.076444,"end_time":"2026-11-01T07:23:08.118118+00:00","exception":false,"start_time":"2026-11-01T07:23:08.041674+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["All sentences successfully stored in SQLite!\n","All sentences successfully stored in SQLite!\n","All sentences successfully stored in SQLite!\n"]}],"source":["\n","import sqlite3\n","import json\n","\n","# Connect to database\n","conn = sqlite3.connect(\"embeddings.db\")\n","cursor = conn.cursor()\n","\n","# Create table\n","cursor.execute(\"\"\"\n","CREATE TABLE IF NOT EXISTS sentences (\n","    id INTEGER PRIMARY KEY AUTOINCREMENT,\n","    sentence TEXT,\n","    embedding TEXT,\n","    metadata TEXT\n",")\n","\"\"\")\n","\n","# Generate and store embeddings\n","for i, sentence in enumerate(sentences1):\n","\n","    embedding = model.encode(sentence2)\n","\n","    