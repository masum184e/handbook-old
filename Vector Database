7.844603Z"},"papermill":{"duration":0.028597,"end_time":"2026-11-03T06:33:57.847484+00:00","exception":false,"start_time":"2026-11-03T06:33:57.818887+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["{'deleted': 0}"]},"execution_count":60,"metadata":{},"output_type":"execute_result"}],"source":["collection.delete(    \n","    where={\"category\": \"backend\"}\n",")\n"]},{"cell_type":"markdown","id":"2dca0162","metadata":{"papermill":{"duration":0.017996,"end_time":"2026-11-03T06:33:57.883328+00:00","exception":false,"start_time":"2026-11-03T06:33:57.865332+00:00","status":"completed"},"tags":[]},"source":["These operations are fundamental when building a production RAG system because the knowledge base changes over time.\n"]},{"cell_type":"markdown","id":"9026d4f0","metadata":{"papermill":{"duration":0.018477,"end_time":"2026-11-03T06:33:57.919898+00:00","exception":false,"start_time":"2026-11-03T06:33:57.901421+00:00","status":"completed"},"tags":[]},"source":["## Metadata filtering in ChromaDB\n","\n","Semantic search alone is not enough for real-world applications.\n","\n","Imagine you have a product catalog with:\n","\n","- 10,000 products\n","- Product categories\n","- Prices\n","- Availability\n","- Brands\n","\n","User query:\n","\n","> \"Find affordable laptops under $800.\"\n","\n","You need both semantic search and structured filtering.\n","\n","### Metadata filtering\n"]},{"cell_type":"code","execution_count":61,"id":"5add6f6c","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:33:57.958276Z","iopub.status.busy":"2026-11-03T06:33:57.957387Z","iopub.status.idle":"2026-11-03T06:33:58.300237Z","shell.execute_reply":"2026-11-03T06:33:58.299301Z"},"papermill":{"duration":0.364967,"end_time":"2026-11-03T06:33:58.302531+00:00","exception":false,"start_time":"2026-11-03T06:33:57.937564+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["results = collection.query(\n","    query_texts=[\"Affordable laptop for programming\"],\n","    n_results=5,\n","    where={\n","        \"$and\": [\n","            {\"category\": \"laptop\"},\n","            {\"price\": {\"$lt\": 800}},\n","            {\"available\": True}\n","        ]\n","    }\n",")"]},{"cell_type":"markdown","id":"7fb32eef","metadata":{"papermill":{"duration":0.01765,"end_time":"2026-11-03T06:33:58.338547+00:00","exception":false,"start_time":"2026-11-03T06:33:58.320897+00:00","status":"completed"},"tags":[]},"source":["\n","This example shows a combination of conditions.\n","\n","The result is restricted to records that match the metadata conditions, then ranked by semantic similarity.\n","\n","Chroma supports metadata filtering through `where` and document-content filtering through `where_document`.&#x20;\n","\n","**Common metadata operators**\n","\n","| Operator | Meaning                        |\n","| -------- | ------------------------------ |\n","| `$eq`    | Equals                         |\n","| `$ne`    | Not equal                      |\n","| `$gt`    | Greater than                   |\n","| `$gte`   | Greater than or equal          |\n","| `$lt`    | Less than                      |\n","| `$lte`   | Less than or equal             |\n","| `$in`    | Value is in a list             |\n","| `$nin`   | Value is not in a list         |\n","| `$and`   | All conditions must match      |\n","| `$or`    | At least one condition matches |\n","\n","For example:\n"]},{"cell_type":"code","execution_count":62,"id":"1eaf6444","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:33:58.37587Z","iopub.status.busy":"2026-11-03T06:33:58.375483Z","iopub.status.idle":"2026-11-03T06:33:58.711198Z","shell.execute_reply":"2026-11-03T06:33:58.710456Z"},"papermill":{"duration":0.357084,"end_time":"2026-11-03T06:33:58.713342+00:00","exception":false,"start_time":"2026-11-03T06:33:58.356258+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["results = collection.query(\n","    query_texts=[\"AI engineering courses\"],\n","    n_results=10,\n","    where={\n","        \"$and\": [\n","            {\"category\": {\"$eq\": \"education\"}},\n","            {\"year\": {\"$gte\": 2024}}\n","        ]\n","    }\n",")"]},{"cell_type":"markdown","id":"39dc2e1a","metadata":{"papermill":{"duration":0.017697,"end_time":"2026-11-03T06:33:58.749471+00:00","exception":false,"start_time":"2026-11-03T06:33:58.731774+00:00","status":"completed"},"tags":[]},"source":["### Document filtering\n","\n","Suppose you want documents containing the word \"Python\".\n"]},{"cell_type":"code","execution_count":63,"id":"fcc900e6","metadata":{"execution":{"iopub.execute_input":"2026-11-03T06:33:58.786999Z","iopub.status.busy":"2026-11-03T06:33:58.786616Z","iopub.status.idle":"2026-11-03T06:33:58.792861Z","shell.execute_reply":"2026-11-03T06:33:58.791884Z"},"papermill":{"duration":0.027428,"end_time":"2026-11-03T06:33:58.794803+00:00","exception":false,"start_time":"2026-11-03T06:33:58.767375+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["results = collection.get(\n","    where_document={\n","        \"$contains\": \"Python\"\n","    }\n",")"]},{"cell_type":"markdown","id":"1af8b0d0","metadata":{"papermill":{"duration":0.017869,"end_time":"2026-11-03T06:33:58.830833+00:00","exception":false,"start_time":"2026-11-03T06:33:58.812964+00:00","status":"completed"},"tags":[]},"source":["This is different from semantic search.\n","\n","Semantic search retrieves by meaning.\n","\n","Document filtering searches for content matching a condition.\n","\n","### Weaviate vs ChromaDB\n","\n","| Feature | Weaviate | ChromaDB |\n","|---|---|---|\n","| Semantic Search | `query.near_text()` | `collection.query()` |\n","| BM25 Search | `query.bm25()` | `collection.search()` with sparse ranking |\n","| Hybrid Search | `query.hybrid()` | `collection.search()` with dense + sparse ranking |\n","| Filtering | `filters` | `where` |\n","| Reranking | Additional reranker integration | Additional reranker integration |\n","\n","# Advanced Production Concepts\n","\n","Knowing how to insert and retrieve vectors is not enough to build a production-grade AI system.\n","\n","You should understand these additional concepts.\n","\n","## Vector dimensionality\n","\n","Dimensionality means the number of values in an embedding.\n","\n","Different embedding models produce different dimensions.\n","\n","| Model                                   | Dimensions |\n","| --------------------------------------- | ---------- |\n","| all-MiniLM-L6-v2                        | 384        |\n","| BAAI/bge-base-en-v1.5                   | 768        |\n","| OpenAI text-embedding-3-small (default) | 1536       |\n","| OpenAI text-embedding-3-large (default) | 3072       |\n","\n","Why does dimensionality matter?\n","\n","- Higher dimensions generally require more storage.\n","- Higher dimensions can increase computational costs.\n","- Different models produce different embedding spaces.\n","- Your database collection must have the correct dimension.\n","\n","Important: You cannot simply insert a 768-dimensional vector into a collection configured for 384 dimensions.\n","\n","Also, higher dimensionality does not automatically mean better retrieval quality.\n","\n","## Vector normalization\n","\n","Normalization means scaling a vector to a particular magnitude, often 1.\n","\n","Formula:\n","\n","$$ A\\_{normalized}=\\frac{A}{||A||} $$\n","\n","Example:\n","\n","$$ A=[3,4] $$\n","\n","Magnitude:\n","\n","$$ ||A||=\\sqrt{3^2+4^2}=5 $$\n","\n","Normalized vector:\n","\n","$$ A'=[0.6,0.8] $$\n","\n","Why normalize?\n","\n","- Removes magnitude differences.\n","- Makes dot product equivalent to cosine similarity for unit vectors.\n","- Can provide consistent retrieval behavior when the model expects normalized embeddings.\n","\n","However, always follow your embedding model's recommendations.\n","\n","## Metadata indexing\n","\n","Metadata filtering can become expensive when you have millions of records.\n","\n","Vector databases may support indexes for metadata fields.\n","\n","For example:\n","\n","```\n","{\n","    \"category\": \"AI\",\n","    \"department\": \"Engineering\",\n","    \"year\": 2026\n","}\n","```\n","\n","You might create indexes on:\n","\n","- category\n","- department\n","- year\n","\n","This can improve filtering performance, depending on the database and query pattern.\n","\n","## Quantization\n","\n","Quantization reduces the precision used to represent vector values.\n","\n","For example:\n","\n","```\n","Original:\n","float32\n","\n","Compressed:\n","int8 or lower-bit representation\n","```\n","\n","It reduces memory requirements and can improve search efficiency.\n","\n","However, compression can introduce numerical error and affect retrieval quality.\n","\n","Remember the difference:\n","\n","- PQ is a specific vector compression technique based on codebooks and subvectors.\n","- Scalar quantization maps individual numerical values to a smaller representation.\n","- Binary quantization represents dimensions using binary values.\n","\n","## Updating and deleting vectors\n","\n","A production application needs to support:\n","\n","- Insert.\n","- Update.\n","- Delete.\n","- Upsert.\n","\n","For example, a company updates its privacy policy.\n","\n","Your RAG system must update the old document embeddings.\n","\n","A good ingestion pipeline should:\n","\n","1. Identify the changed source document.\n","2. Remove or replace its old chunks.\n","3. Generate new chunks.\n","4. Generate new embeddings.\n","5. Insert the updated vectors.\n","6. Verify the updated records.\n","\n","Use stable document IDs and chunk IDs to prevent duplicate or stale records."]},{"cell_type":"code","execution_count":null,"id":"12ae7acc","metadata":{"papermill":{"duration":0.017786,"end_time":"2026-11-03T06:33:58.866397+00:00","exception":false,"start_time":"2026-11-03T06:33:58.848611+00:00","status":"completed"},"tags":[]},"outputs":[],"source":[]}],"metadata":{"kaggle":{"accele