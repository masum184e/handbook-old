:19:47.428326+00:00","exception":false,"start_time":"2026-11-13T18:19:47.408146+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class SelfAttention(nn.Module):\n","\n","    def __init__(self, d_model):\n","        super().__init__()\n","\n","        self.d_model = d_model\n","\n","        # Linear projections\n","        self.W_q = nn.Linear(d_model, d_model)\n","        self.W_k = nn.Linear(d_model, d_model)\n","        self.W_v = nn.Linear(d_model, d_model)\n","\n","    def forward(self, x):\n","\n","        # Generate Query, Key, and Value\n","        Q = self.W_q(x)\n","        K = self.W_k(x)\n","        V = self.W_v(x)\n","\n","        # Calculate attention scores\n","        scores = torch.matmul(\n","            Q,\n","            K.transpose(-2, -1)\n","        )\n","\n","        # Scale attention scores\n","        scores = scores / math.sqrt(self.d_model)\n","\n","        # Apply softmax\n","        attention_weights = torch.softmax(\n","            scores,\n","            dim=-1\n","        )\n","\n","        # Calculate attention output\n","        output = torch.matmul(\n","            attention_weights,\n","            V\n","        )\n","\n","        return output, attention_weights"]},{"cell_type":"code","execution_count":69,"id":"343b237d","metadata":{"execution":{"iopub.execute_input":"2026-11-13T18:19:47.450783Z","iopub.status.busy":"2026-11-13T18:19:47.450328Z","iopub.status.idle":"2026-11-13T18:19:47.456262Z","shell.execute_reply":"2026-11-13T18:19:47.455371Z"},"papermill":{"duration":0.019581,"end_time":"2026-11-13T18:19:47.458326+00:00","exception":false,"start_time":"2026-11-13T18:19:47.438745+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# Initialize self-attention\n","self_attention = SelfAttention(d_model=d_model)"]},{"cell_type":"code","execution_count":70,"id":"f608aaab","metadata":{"execution":{"iopub.execute_input":"2026-11-13T18:19:47.480538Z","iopub.status.busy":"2026-11-13T18:19:47.480219Z","iopub.