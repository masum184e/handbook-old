e":"2026-11-08T03:54:16.211212Z","shell.execute_reply":"2026-11-08T03:54:16.210371Z"},"papermill":{"duration":0.074433,"end_time":"2026-11-08T03:54:16.213291+00:00","exception":false,"start_time":"2026-11-08T03:54:16.138858+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import torch\n","import torch.nn as nn\n","\n","embedding_layer = nn.Embedding(vocab_size, embedding_dim)\n","\n","token_ids = torch.tensor(output.ids, dtype=torch.long)\n","embeddings = embedding_layer(token_ids)"]},{"cell_type":"code","execution_count":27,"id":"9a28ca3e","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:54:16.235871Z","iopub.status.busy":"2026-11-08T03:54:16.235285Z","iopub.status.idle":"2026-11-08T03:54:16.263355Z","shell.execute_reply":"2026-11-08T03:54:16.262374Z"},"papermill":{"duration":0.041768,"end_time":"2026-11-08T03:54:16.265428+00:00","exception":false,"start_time":"2026-11-08T03:54:16.22366+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":[" Token ID   Token  Dimension 1  Dimension 2  Dimension 3  Dimension 4  Dimension 5\n","       22     The        -0.00        -0.30        -1.46        -0.10        -0.60\n","       24     cat        -0.01         0.24         0.13         0.76         1.10\n","       32     sat        -1.90         0.23         0.02        -0.35         0.29\n","       31      on         1.60        -2.48        -0.42        -1.20         0.81\n","       28     the        -0.38         1.03        -0.69         0.64        -0.97\n","       25     mat         0.34         0.72         0.41         1.93         1.01\n","       50 because         0.72         0.04         1.31         0.25        -1.98\n","       30      it        -0.73         0.10         0.35         0.97        -0.47\n","       29     was         0.96         1.62         1.45         0.27        -0.21\n","       34   tired         1.29         0.05        -1.55         0.76         0.78\n","        1       .        -1.23        -0.04        -1.60        -0.75         1.65\n"]}],"source":["import pandas as pd\n","\n","# Create embedding table\n","data = embeddings.detach().numpy()\n","\n","df = pd.DataFrame(\n","    data,\n","    columns=[f\"Dimension {i+1}\" for i in range(data.shape[1])]\n",")\n","\n","# Add Token ID and Word columns\n","df.insert(0, \"Token ID\", output.ids)\n","df.insert(1, \"Token\", tokens)\n","\n","# Display table\n","print(df.round(2).to_string(index=False))"]},{"cell_type":"markdown","id":"532ea2c6","metadata":{"papermill":{"duration":0.010198,"end_time":"2026-11-08T03:54:16.286255+00:00","exception":false,"start_time":"2026-11-08T03:54:16.276057+00:00","status":"completed"},"tags":[]},"source":["The model has an embedding dimension of 5 because the `embedding_dim` is set to 5, for more dimension set it that number.\n","\n","When the model receives token ID `24`, it retrieves the corresponding embedding: `[0.17,        -1.17,        -0.60,        -1.00,        -0.50]`. The corresponding word is `cat`.\n","\n","## Special tokens\n","\n","Not every token represents an ordinary word. LLMs also use special tokens to control the structure and flow of conversations.\n","\n","Examples include:\n","\n","| Special token | Purpose                                          |\n","| ------------- | ------------------------------------------------ |\n","| BOS           | Beginning of sequence                            |\n","| EOS           | End of sequence                                  |\n","| PAD           | Padding sequences                                |\n","| UNK           | Unknown token in some tokenizers                 |\n","| SEP           | Separates text segments in some models           |\n","| MASK          | Represents masked content in models such as BERT |\n","\n","Some GPT-style conversational formats use tokens such as:\n","\n","- `<|im_start|>` — starts a message.\n","- `<|im_sep|>` — separates a message header from its content.\n","- `<|im_end|>` — ends a message.\n","- `<|endoftext|>` — a special end-of-text token in certain GPT tokenizers.\n","- `<|ghissue|>` — not a standard token; avoid assuming that all models share the same special-token vocabulary.\n","\n","For example, a simplified conversational representation might look like:\n","\n","```\n","<|im_start|>user\n","What is machine learning?\n","<|im_end|>\n","\n","<|im_start|>assistant\n","Machine learning is a branch of AI...\n","<|im_end|>\n","```\n","\n","These markers help a model distinguish between different messages and their boundaries. Actual chat formats vary between model providers.\n","\n","## Detokenization\n","\n","Detokenization is the reverse process of tokenization.\n","\n","Tokenization:\n","\n","```\n","Human-readable text\n","       ↓\n","     Tokens\n","       ↓\n","   Token IDs\n","```\n","\n","Detokenization:\n","\n","```\n","   Token IDs\n","       ↓\n","     Tokens\n","       ↓\n","Human-readable text\n","```"]},{"cell_type":"code","execution_count":28,"id":"cfe6d6b5","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:54:16.308727Z","iopub.status.busy":"2026-11-08T03:54:16.308341Z","iopub.status.idle":"2026-11-08T03:54:16.312912Z","shell.execute_reply":"2026-11-08T03:54:16.311884Z"},"papermill":{"duration":0.018178,"end_time":"2026-11-08T03:54:16.314842+00:00","exception":false,"start_time":"2026-11-08T03:54:16.296664+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# Decode token IDs\n","decoded_text = tokenizer.decode(output.ids)"]},{"cell_type":"code","execution_count":29,"id":"9ac30890","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:54:16.337563Z","iopub.status.busy":"2026-11-08T03:54:16.337197Z","iopub.status.idle":"2026-11-08T03:54:16.342259Z","shell.execute_reply":"2026-11-08T03:54:16.341347Z"},"papermill":{"duration":0.018682,"end_time":"2026-11-08T03:54:16.344255+00:00","exception":false,"start_time":"2026-11-08T03:54:16.325573+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Token IDs: [22, 24, 32, 31, 28, 25, 50, 30, 29, 34, 1]\n","Decoded text: The cat sat on the mat because it was tired .\n"]}],"source":["print(\"Token IDs:\", output.ids)\n","print(\"Decoded text:\", decoded_text)"]},{"cell_type":"markdown","id":"aeb44ae3","metadata":{"papermill":{"duration":0.010347,"end_time":"2026-11-08T03:54:16.364984+00:00","exception":false,"start_time":"2026-11-08T03:54:16.354637+00:00","status":"completed"},"tags":[]},"source":["**One important detail:** some tokenizers operate at the byte level, so decoding must correctly reconstruct UTF-8 text. You cannot always simply join token strings with spaces.\n","\n","## Relationship between tokenization and context windows\n","\n","A context window represents the maximum number of tokens a model can process in a given request, subject to the model's specific architecture and API limits.\n","\n","For example, suppose a model supports a context window of 8,192 tokens.\n","\n","Your input contains:\n","\n","```\n","System prompt:       500 tokens\n","User question:       200 tokens\n","Retrieved RAG data:  6,000 tokens\n","Conversation history: 1,000 tokens\n","```\n","\n","Total:\n","\n","$$ 500+200+6000+1000=7700 $$\n","\n","You have:\n","\n","$$ 8192-7700=492 $$\n","\n","tokens remaining.\n","\n","This is a simplified example; output-token reservations and provider-specific accounting also matter.\n","\n","Why should an AI engineer care?\n","\n","Because tokenization directly affects:\n","\n","1. Context-window usage.\n","2. API costs.\n","3. Response latency.\n","4. RAG chunk sizes.\n","5. Maximum input and output lengths.\n","6. How much conversation history you can retain.\n","\n","### Tokenization in RAG\n","\n","Imagine you retrieve 10 documents from a vector database. Each document contains 1,000 tokens.\n","\n","Your retrieved context contains:\n","\n","$$ 10 \\times 1000 = 10000 \\text{ tokens} $$\n","\n","If your model only has 8,192 tokens available for the entire request, you cannot simply insert all 10 documents alongside your instructions and question.\n","\n","You need to:\n","\n","- Reduce the number of retrieved documents.\n","- Use smaller chunks.\n","- Rerank the retrieved chunks.\n","- Remove redundant content.\n","- Compress or summarize retrieved information.\n","\n","This is why tokenization is important when designing RAG pipelines.\n","\n","## Why does the same sentence produce different token counts?\n","\n","Different LLMs can use different tokenizers and vocabularies.\n","\n","Consider: `Artificial Intelligence`\n","\n","- One tokenizer might produce: `[\"Artificial\", \" Intelligence\"]`\n","- Another might produce: `[\"Art\", \"ificial\", \" Intelligence\"]`\n","\n","Both are valid tokenization strategies.\n","\n","Other factors that affect token counts include:\n","\n","- Language.\n","- Special characters.\n","- Emojis.\n","- Numbers.\n","- Programming code.\n","- Whitespace.\n","- Vocabulary and tokenizer design.\n","\n","For example, Bangla text can have a different token-to-character ratio from English text.\n","\n","This is important when building multilingual applications.\n","\n","## Misconceptions\n","\n","| Misconception                               | Correct understanding                                                                   |\n","| ------------------------------------------- | --------------------------------------------------------------------------------------- |\n","| One token equals one word                   | A token can be a word, subword, character, or byte sequence.                            |\n","| Token IDs represent meaning                 | Token IDs are identifiers, not semantic values.                                         |\n","| Tokenization understands language           | Tokenization segments text; semantic representations are learned by the neural network. |\n","| All LLMs use the same tokenizer             | Different models can use different tokenizers.                                          |\n","| Tokenization and embedding are the same     | Tokenization creates tokens; embedding maps token IDs into vectors.                     |\n","| A shorter sentence always uses fewer tokens | Token count depends on the tokenizer and text composition.                              |\n","\n","## Interview questions\n","\n","<details>\n","\n","<summary>What is tokenization?</summary>\n","\n","Tokenization is the process of converting raw text into smaller units called tokens. These tokens are then mapped to numerical IDs, which an LLM uses as input.\n","\n","</details>\n","\n","<details>\n","\n","<summary>Why do modern LLMs use subword tokenization?</summary>\n","\n","Subword tokenization balances vocabulary size and sequence length. It allows models to represent unfamiliar words by combining smaller known pieces instead of requiring every possible word in the vocabulary.\n","\n","</details>\n","\n","<details>\n","\n","<summary>What is the difference between BPE and WordPiece?</summary>\n","\n","BPE repeatedly merges frequent adjacent token pairs, whereas WordPiece generally selects vocabulary merges based on their improvement to the likelihood of the training data.\n","\n","</details>\n","\n","<details>\n","\n","<summary>What is the difference between tokenization and embedding?</summary>\n","\n","Tokenization converts text into tokens and token IDs. Embedding converts token IDs into dense numerical vectors that a neural network can process.\n","\n","</details>\n","\n","<details>\n","\n","<summary>What happens when a model encounters an unknown word?</summary>\n","\n","A subword or byte-level tokenizer can often represent the unfamiliar word using smaller known units. Therefore, it doesn't necessarily need an unknown-token representation.\n","\n","</details>\n","\n","<details>\n","\n","<summary>How does tokenization affect LLM API costs?</summary>\n","\n","Many LLM APIs calculate input and output charges based on token counts. More tokens generally mean higher costs, although exact pricing depends on the provider and model.\n","\n","</details>\n","\n","<details>\n","\n","<summary>Why is tokenization important in RAG?</summary>\n","\n","It helps control the size of retrieved context, chunk sizes, context-window consumption, and API costs.\n","\n","</details>\n","\n","<details>\n","\n","<summary>What is detokenization?</summary>\n","\n","Detokenization converts token IDs back into human-readable text.\n","\n","</details>\n","\n","# Positional Encoding\n","\n","Positional Encoding is a technique used in Transformer architectures to give the model information about the position or order of tokens in a sequence.\n","\n","## Why do we need positional encoding?\n","\n","Consider these two sentences:\n","\n","- Sentence A: `The cat ate the mouse.`\n","- Sentence B: `The mouse ate the cat.`\n","\n","Both sentences contain almost exactly the same words, but their meanings are completely different. The difference comes from the order of the words.\n","\n","Now, consider how a Transformer processes text. First, it converts tokens into numerical vectors using an embedding layer.\n","\n","For example:\n","\n","| Token | Token embedding         |\n","| ----- | ----------------------- |\n","| The   | [0.21, 0.45, 0.12, ...] |\n","| cat   | [0.32, 0.18, 0.67, ...] |\n","| ate   | [0.51, 0.22, 0.39, ...] |\n","| mouse | [0.14, 0.71, 0.28, ...] |\n","\n","The problem is that self-attention, by itself, does not inherently know the original order of these tokens. Self-attention can determine relationships between tokens, but without positional information, it does not know whether `cat` appeared before or after `ate`. This is why we introduce positional encoding. It adds positional information to token embeddings so the Transformer can understand the sequence order.\n","\n","## Where does positional encoding happen in a Transformer?\n","\n","The process is:\n","\n","1. User provides text.\n","2. Tokenizer converts text into token IDs.\n","3. Embedding layer converts token IDs into vectors.\n","4. **Positional encoding** generates position vectors.\n","5. **Token embeddings and positional encodings are added together.**\n","6. The resulting vectors are passed into the Transformer layers.\n","\n","The mathematical operation is:\n","\n","$$ X = E + PE $$\n","\n","Where:\n","\n","- $X$ = final input representation.\n","- $E$ = token embedding.\n","- $PE$ = positional encoding.\n","\n","For example:\n","\n","Suppose we have a token embedding:\n","\n","$$ E\\_{\\text{cat}}=[0.2,0.4,0.6,0.8] $$\n","\n","And its positional encoding:\n","\n","$$ PE_1=[0.1,0.3,0.5,0.7] $$\n","\n","Then:\n","\n","$$ X\\_{\\text{cat}} = [0.3,0.7,1.1,1.5] $$\n","\n","This final vector contains both:\n","\n","- Semantic information: What does the token mean?\n","- Positional information: Where does the token appear?\n","\n","An important point: positional encoding does not replace token embeddings. It adds information to them.\n","\n","## Internal Working\n","\n","In the original Transformer architecture ([Attention Is All You Need, 2017](https://proceedings.neurips.cc/paper_files/paper/2017/file/3f5ee243547dee91fbd053c1c4a845aa-Paper.pdf)), the authors introduced Sinusoidal Positional Encoding.\n","\n","It uses mathematical functions called:\n","\n","- Sine\n","- Cosine\n","\n","These functions generate unique position-dependent patterns.\n","\n","The formulas are:\n","\n","For even dimensions:\n","\n","$$ PE(pos,2i)= \\sin\\left( \\frac{pos}{10000^{2i/d\\_{model}}} \\right) $$\n","\n","For odd dimensions:\n","\n","$$ PE(pos,2i+1)= \\cos\\left( \\frac{pos}{10000^{2i/d\\_{model}}} \\right) $$\n","\n","Let's understand every variable.\n","\n","| Variable         | Meaning                                       |\n","| ---------------- | --------------------------------------------- |\n","| $pos$        | Position of the token in the sequence         |\n","| $i$          | Dimension index pair                          |\n","| $d\\_{model}$ | Embedding dimension                           |\n","| $2i$         | Even dimension                                |\n","| $2i+1$       | Odd dimension                                 |\n","| 10000            | Constant controlling the range of frequencies |\n","\n","### Why are there different frequencies?\n","\n","Because the Transformer needs positional patterns at different scales.\n","\n","- Higher-frequency dimensions change more quickly between positions.\n","- Lower-frequency dimensions change more slowly.\n","\n","This creates a combination of patterns that helps the Transformer distinguish different token positions.\n","\n","\n","Look at this part:\n","\n","$$\n","10000^{2i/d_{model}}\n","$$\n","\n","This is the denominator that controls the frequency.\n","\n","For example, suppose:\n","\n","$$\n","d_{model}=8\n","$$\n","\n","We have four pairs of sine and cosine dimensions.\n","\n","| i | Denominator | Frequency |\n","| --- | --- | --- |\n","| 0 | 1 | Highest |\n","| 1 | 10 | Lower |\n","| 2 | 100 | Lower |\n","| 3 | 1000 | Lowest |\n","\n","Notice what happens:\n","\n","- Dividing by 1 makes the wave change quickly.\n","- Dividing by 10 makes it change more slowly.\n","- Dividing by 100 makes it even slower.\n","- Dividing by 1000 makes it very slow.\n","\n","This is how different dimensions capture different positional scales.\n","\n","\n","**Important:** When the embedding dimension is odd, the final dimension has no cosine partner. This is perfectly valid in the original Transformer positional encoding method.\n","\n","These vectors represent the positions, not the meanings of the words.\n","\n","## Sine and Cosine\n","\n","This is an important theoretical question. Why didn't the original Transformer use only sine? There are three main reasons.\n","\n","### Different patterns\n","\n","Sine and cosine are phase-shifted versions of each other.\n","\n","$$ \\cos(x)=\\sin(x+\\pi/2) $$\n","\n","Using both provides two complementary values for each frequency.\n","\n","### Relative position information\n","\n","The sinusoidal functions have a useful mathematical property.\n","\n","For a given frequency $\\omega$:\n","\n","$$ \\sin((pos+k)\\omega) $$\n","\n","and\n","\n","$$ \\cos((pos+k)\\omega) $$\n","\n","can be expressed using the sine and cosine values at $pos$.\n","\n","Using angle addition:\n","\n","$$ \\sin(a+b)=\\sin(a)\\cos(b)+\\cos(a)\\sin(b) $$\n","\n","$$ \\cos(a+b)=\\cos(a)\\cos(b)-\\sin(a)\\sin(b) $$\n","\n","This means a fixed positional offset can be represented through a transformation of the original positional values. It helps the model learn relationships between relative positions.\n","\n","For example:\n","\n","- cat is 1 position after The.\n","- sat is 1 position after cat.\n","- sat is 2 positions after The.\n","\n","### Different frequencies\n","\n","- Different dimensions encode positional patterns at different scales.\n","- Some dimensions change rapidly, while others change slowly.\n","- Combining them helps represent both short-range and long-range positional information.\n","\n","## Types of positional Encoding\n","\n","Sinusoidal positional encoding is not the only approach. There are several important approaches used in Transformer architectures.\n","\n","### Sinusoidal positional encoding\n","\n","Uses fixed sine and cosine mathematical functions.\n","\n","- Original Transformer approach.\n","- No trainable positional parameters.\n","- Position vectors are calculated mathematically.\n","\n","![Sinusoidal Positional Encoding](https://raw.githubusercontent.com/masum184e/handbook/main/static/img/ai-engineering/sinusoidal_positional_encoding.png)"]},{"cell_type":"code","execution_count":30,"id":"bd5e8c6f","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:54:16.387786Z","iopub.status.busy":"2026-11-08T03:54:16.386955Z","iopub.status.idle":"2026-11-08T03:54:16.391512Z","shell.execute_reply":"20