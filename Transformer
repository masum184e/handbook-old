-11-05T12:49:35.200014Z","shell.execute_reply":"2026-11-05T12:49:35.198793Z","shell.execute_reply.started":"2026-11-05T12:49:35.19198Z"},"papermill":{"duration":0.009462,"end_time":"2026-11-08T03:53:55.216123+00:00","exception":false,"start_time":"2026-11-08T03:53:55.206661+00:00","status":"completed"},"tags":[]},"source":["**How does it work?**\n","\n","The tokenizer identifies spaces and punctuation and splits the sentence accordingly.\n","\n","**Advantages:**\n","\n","- Easy to implement.\n","- Easy to understand.\n","- Words remain meaningful units.\n","\n","**Disadvantages:**\n","\n","- Very large vocabulary.\n","- Cannot efficiently handle unseen words.\n","- Different word forms may require separate vocabulary entries.\n","\n","For example:\n","\n","```\n","play\n","playing\n","played\n","player\n","```\n","\n","A word-based tokenizer may need four separate vocabulary entries. This becomes problematic when working with millions of possible words.\n","\n","### Character-based tokenization\n","\n","Instead of splitting text into words, this method splits it into individual characters."]},{"cell_type":"code","execution_count":8,"id":"c381731b","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:53:55.236692Z","iopub.status.busy":"2026-11-08T03:53:55.236331Z","iopub.status.idle":"2026-11-08T03:53:55.240603Z","shell.execute_reply":"2026-11-08T03:53:55.239757Z"},"papermill":{"duration":0.017083,"end_time":"2026-11-08T03:53:55.242511+00:00","exception":false,"start_time":"2026-11-08T03:53:55.225428+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["char_tokens = list(text)"]},{"cell_type":"code","execution_count":9,"id":"19bca346","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:53:55.26283Z","iopub.status.busy":"2026-11-08T03:53:55.262477Z","iopub.status.idle":"2026-11-08T03:53:55.267622Z","shell.execute_reply":"2026-11-08T03:53:55.266612Z"},"papermill":{"duration":0.017518,"end_time":"2026-11-08T03:53:55.269615+00:00","exception":false,"start_time":"2026-11-08T03:53:55.252097+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Original Text: The cat sat on the mat because it was tired.\n","Char Tokens: ['T', 'h', 'e', ' ', 'c', 'a', 't', ' ', 's', 'a', 't', ' ', 'o', 'n', ' ', 't', 'h', 'e', ' ', 'm', 'a', 't', ' ', 'b', 'e', 'c', 'a', 'u', 's', 'e', ' ', 'i', 't', ' ', 'w', 'a', 's', ' ', 't', 'i', 'r', 'e', 'd', '.']\n"]}],"source":["print(\"Original Text:\", text)\n","print(f\"Char Tokens: {char_tokens}\")"]},{"cell_type":"markdown","id":"22e72628","metadata":{"papermill":{"duration":0.009045,"end_time":"2026-11-08T03:53:55.287967+00:00","exception":false,"start_time":"2026-11-08T03:53:55.278922+00:00","status":"completed"},"tags":[]},"source":["**Advantages:**\n","\n","- Very small vocabulary.\n","- Can represent almost any word.\n","- Handles unfamiliar words naturally.\n","\n","**Disadvantages:**\n","\n","- Creates many more tokens.\n","- The model needs to learn word-level patterns from individual characters.\n","- Longer sequences increase computational costs.\n","\n","### Byte-based tokenization\n","\n","Byte-based tokenization represents text using bytes, often UTF-8 bytes."]},{"cell_type":"code","execution_count":10,"id":"caa0d0f6","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:53:55.308292Z","iopub.status.busy":"2026-11-08T03:53:55.307926Z","iopub.status.idle":"2026-11-08T03:53:55.312393Z","shell.execute_reply":"2026-11-08T03:53:55.311575Z"},"papermill":{"duration":0.017121,"end_time":"2026-11-08T03:53:55.314322+00:00","exception":false,"start_time":"2026-11-08T03:53:55.297201+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["byete_tokens = text.encode('utf-8')"]},{"cell_type":"code","execution_count":11,"id":"3cdb1580","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:53:55.334827Z","iopub.status.busy":"2026-11-08T03:53:55.334341Z","iopub.status.idle":"2026-11-08T03:53:55.339883Z","shell.e