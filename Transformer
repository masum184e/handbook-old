0014Z","shell.execute_reply":"2026-11-05T12:49:35.198793Z","shell.execute_reply.started":"2026-11-05T12:49:35.19198Z"},"papermill":{"duration":0.007265,"end_time":"2026-11-13T18:19:17.92996+00:00","exception":false,"start_time":"2026-11-13T18:19:17.922695+00:00","status":"completed"},"tags":[]},"source":["**How does it work?**\n","\n","The tokenizer identifies spaces and punctuation and splits the sentence accordingly.\n","\n","**Advantages:**\n","\n","- Easy to implement.\n","- Easy to understand.\n","- Words remain meaningful units.\n","\n","**Disadvantages:**\n","\n","- Very large vocabulary.\n","- Cannot efficiently handle unseen words.\n","- Different word forms may require separate vocabulary entries.\n","\n","For example:\n","\n","```\n","play\n","playing\n","played\n","player\n","```\n","\n","A word-based tokenizer may need four separate vocabulary entries. This becomes problematic when working with millions of possible words.\n","\n","### Character-based tokenization\n","\n","Instead of splitting text into words, this method splits it into individual characters."]},{"cell_type":"code","execution_count":8,"id":"5cb063c7","metadata":{"execution":{"iopub.execute_input":"2026-11-13T18:19:17.948307Z","iopub.status.busy":"2026-11-13T18:19:17.947959Z","iopub.status.idle":"2026-11-13T18:19:17.953064Z","shell.execute_reply":"2026-11-13T18:19:17.951984Z"},"papermill":{"duration":0.017542,"end_time":"2026-11-13T18:19:17.954954+00:00","exception":false,"start_time":"2026-11-13T18:19:17.937412+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["char_tokens = list(text)"]},{"cell_type":"code","execution_count":9,"id":"697becc1","metadata":{"execution":{"iopub.execute_input":"2026-11-13T18:19:17.972134Z","iopub.status.busy":"2026-11-13T18:19:17.971812Z","iopub.status.idle":"2026-11-13T18:19:17.976189Z","shell.execute_reply":"2026-11-13T18:19:17.975468Z"},"papermill":{"duration":0.015031,"end_time":"2026-11-13T18:19:17.977806+00:00","exception":false,"start_time":"2026-11-13T18:19:17.962775+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Original Text: The cat sat on the mat because it was tired.\n","Char Tokens: ['T', 'h', 'e', ' ', 'c', 'a', 't', ' ', 's', 'a', 't', ' ', 'o', 'n', ' ', 't', 'h', 'e', ' ', 'm', 'a', 't', ' ', 'b', 'e', 'c', 'a', 'u', 's', 'e', ' ', 'i', 't', ' ', 'w', 'a', 's', ' ', 't', 'i', 'r', 'e', 'd', '.']\n"]}],"source":["print(\"Original Text:\", text)\n","print(f\"Char Tokens: {char_tokens}\")"]},{"cell_type":"markdown","id":"c3ab11a3","metadata":{"papermill":{"duration":0.007502,"end_time":"2026-11-13T18:19:17.993189+00:00","exception":false,"start_time":"2026-11-13T18:19:17.985687+00:00","status":"completed"},"tags":[]},"source":["**Advantages:**\n","\n","- Very small vocabulary.\n","- Can represent almost any word.\n","- Handles unfamiliar words naturally.\n","\n","**Disadvantages:**\n","\n","- Creates many more tokens.\n","- The model needs to learn word-level patterns from individual characters.\n","- Longer sequences increase computational costs.\n","\n","### Byte-based tokenization\n","\n","Byte-based tokenization represents text using bytes, often UTF-8 bytes."]},{"cell_type":"code","execution_count":10,"id":"452caa43","metadata":{"execution":{"iopub.execute_input":"2026-11-13T18:19:18.011508Z","iopub.status.busy":"2026-11-13T18:19:18.010779Z","iopub.status.idle":"2026-11-13T18:19:18.014864Z","shell.execute_reply":"2026-11-13T18:19:18.013982Z"},"papermill":{"duration":0.014958,"end_time":"2026-11-13T18:19:18.016865+00:00","exception":false,"start_time":"2026-11-13T18:19:18.001907+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["byete_tokens = text.encode('utf-8')"]},{"cell_type":"code","execution_count":11,"id":"a7976634","metadata":{"execution":{"iopub.execute_input":"2026-11-13T18:19:18.034707Z","iopub.status.busy":"2026-11-13T18:19:18.034401Z","iopub.status.idle":"2026-11-13T18:19:18.039153Z","shell.execute_reply":"202