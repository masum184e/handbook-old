orch.float\n","        ).unsqueeze(1)\n","\n","        div_term = torch.exp(\n","            torch.arange(0, embedding_dim, 2).float()\n","            * (-math.log(10000.0) / embedding_dim)\n","        )\n","\n","        pe[:, 0::2] = torch.sin(position * div_term)\n","\n","        pe[:, 1::2] = torch.cos(\n","            position * div_term[:pe[:, 1::2].shape[1]]\n","        )\n","\n","        pe = pe.unsqueeze(0)\n","\n","        self.register_buffer(\"pe\", pe)\n","\n","    def forward(self, x):\n","\n","        seq_len = x.size(1)\n","\n","        return x + self.pe[:, :seq_len, :]\n"]},{"cell_type":"code","execution_count":51,"id":"d5e80d1a","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:54:17.196954Z","iopub.status.busy":"2026-11-08T03:54:17.196568Z","iopub.status.idle":"2026-11-08T03:54:17.205333Z","shell.execute_reply":"2026-11-08T03:54:17.204607Z"},"papermill":{"duration":0.023189,"end_time":"2026-11-08T03:54:17.207344+00:00","exception":false,"start_time":"2026-11-08T03:54:17.184155+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["pos_embedding = SinusoidalPositionalEmbedding(\n","    embedding_dim=embedding_dim,\n","    max_len=max_len\n",")\n","\n","# Get positional embeddings\n","final_embeddings = pos_embedding(\n","    embeddings\n",")"]},{"cell_type":"code","execution_count":52,"id":"548ad9ab","metadata":{"execution":{"iopub.execute_input":"2026-11-08T03:54:17.23169Z","iopub.status.busy":"2026-11-08T03:54:17.231321Z","iopub.status.idle":"2026-11-08T03:54:17.244062Z","shell.execute_reply":"2026-11-08T03:54:17.243146Z"},"papermill":{"duration":0.027335,"end_time":"2026-11-08T03:54:17.246078+00:00","exception":false,"start_time":"2026-11-08T03:54:17.218743+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":[" Token ID  Position   Token  Dimension 1  Dimension 2  Dimension 3  Dimension 4  Dimension 5\n","       22         0     The        -0.00         0.70        -1.46         