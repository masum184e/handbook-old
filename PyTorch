n":0.040499,"end_time":"2026-11-16T13:19:09.614024+00:00","exception":false,"start_time":"2026-11-16T13:19:09.573525+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["x = torch.tensor([1.0, 2.0, 3.0])\n","\n","output = layer(x)"]},{"cell_type":"code","execution_count":8,"id":"7c3073a2","metadata":{"execution":{"iopub.execute_input":"2026-11-16T13:19:09.624149Z","iopub.status.busy":"2026-11-16T13:19:09.623711Z","iopub.status.idle":"2026-11-16T13:19:09.631771Z","shell.execute_reply":"2026-11-16T13:19:09.630699Z"},"papermill":{"duration":0.015761,"end_time":"2026-11-16T13:19:09.633971+00:00","exception":false,"start_time":"2026-11-16T13:19:09.61821+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["tensor([ 1.2556, -1.3235], grad_fn=<ViewBackward0>)"]},"execution_count":8,"metadata":{},"output_type":"execute_result"}],"source":["output"]},{"cell_type":"markdown","id":"2f4d040b","metadata":{"papermill":{"duration":0.004443,"end_time":"2026-11-16T13:19:09.643659+00:00","exception":false,"start_time":"2026-11-16T13:19:09.639216+00:00","status":"completed"},"tags":[]},"source":["Let's manually calculate the output using our illustrative weights.\n","\n","For example, imagine the following weights:\n","\n","$$ W = \\begin{bmatrix} 0.2 & 0.5 & 0.3\\\\\\ 0.4 & 0.1 & 0.6 \\end{bmatrix} $$\n","\n","And bias:\n","\n","$$ b = \\begin{bmatrix} 0.1 & 0.2 \\end{bmatrix} $$\n","\n","\n","Input:\n","\n","$$ X = [1,2,3] $$\n","\n","First output neuron:\n","\n","$$ y_1 = (1 \\times 0.2) +(2 \\times 0.5) +(3 \\times 0.3)+0.1 $$\n","\n","$$ y_1 = 2.0 $$\n","\n","Second output neuron:\n","\n","$$ y_2 = (1 \\times 0.4) +(2 \\times 0.1) +(3 \\times 0.6)+0.2 $$\n","\n","$$ y_2 = 2.6 $$\n","\n","Final output:\n","\n","$$ Y = [2.0,2.6] $$\n","\n","That's exactly what a Linear layer does.\n","\n","## Multiple Input\n","\n","This is particularly important when training neural networks.\n","\n","Suppose we have 4 samples, each containing 3 features."]},{"cell_