]], grad_fn=<AddBackward0>)"]},"execution_count":11,"metadata":{},"output_type":"execute_result"}],"source":["torch.matmul(x, layer.weight.T) + layer.bias"]},{"cell_type":"markdown","id":"156a80ec","metadata":{"papermill":{"duration":0.004351,"end_time":"2026-11-16T13:19:09.724926+00:00","exception":false,"start_time":"2026-11-16T13:19:09.720575+00:00","status":"completed"},"tags":[]},"source":["Why? Because:\n","\n","- 4 = Number of input samples.\n","- 2 = Number of output features.\n","\n","The mathematical operation becomes:\n","\n","$$ (4 \\times 3)(3 \\times 2)+(1 \\times 2) $$\n","\n","$$ Y = (4 \\times 2) $$\n","\n","Each row is independently transformed using the same weights and biases.\n","\n","**Important:** PyTorch does not create separate weights for each input sample.\n","\n","## Parameters (Linear)\n","\n","PyTorch provides additional options:\n","```python\n","import torch\n","import torch.nn as nn\n","\n","linear = nn.Linear(\n","    in_features=512,\n","    out_features=768,\n","    bias=True,\n","    device=\"cuda\",\n","    dtype=torch.float32\n",")\n","```\n","\n","Some important ones:\n","\n","| Parameter | Description |\n","| --- | --- |\n","| `in_features` | Number of input features |\n","| `out_features` | Number of output features |\n","| `bias` | Whether to include a learnable bias (`True` by default) |\n","| `device` | Device where parameters are allocated (e.g. CPU or CUDA) |\n","| `dtype` | Data type of parameters (e.g. `torch.float32`, `torch.float16`) |\n","\n","\n","## Learn Weights (Linear)\n","\n","This is where neural networks become interesting. Initially, PyTorch initializes weights and biases with values that are not necessarily useful for your task.\n","\n","During training, the model learns better values using:\n","\n","1. Forward propagation.\n","2. Loss calculation.\n","3. Backpropagation.\n","4. Optimizer updates."]},{"cell_type":"code","execution_count":12,"id":"32b8f019","metadata":{"execution":{"iopub.execute_input":"2026-11-16T13:19:09.73563Z","iopub.status.busy":"2026-11-16T13:19:09.735245Z","iopub.status.idle":"2026-11-16T13:19:16.368039Z","shell.execute_reply":"2026-11-16T13:19:16.366841Z"},"papermill":{"duration":6.641,"end_time":"2026-11-16T13:19:16.370342+00:00","exception":false,"start_time":"2026-11-16T13:19:09.729342+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["INITIAL PARAMETERS\n","Weight: tensor([[0.5000, 0.3000]])\n","Bias: tensor([0.1000])\n","\n","--- Epoch 1 ---\n","Prediction: 2.0\n","Loss: 9.0\n","Weight gradients: tensor([[-12., -18.]])\n","Bias gradients: tensor([-6.])\n","Old weight: tensor([[0.5000, 0.3000]])\n","New weight: tensor([[0.6200, 0.4800]])\n","Old bias: tensor([0.1000])\n","New bias: tensor([0.1600])\n","\n","--- Epoch 2 ---\n","Prediction: 2.8400001525878906\n","Loss: 4.665599346160889\n","Weight gradients: tensor([[ -8.6400, -12.9600]])\n","Bias gradients: tensor([-4.3200])\n","Old weight: tensor([[0.6200, 0.4800]])\n","New weight: tensor([[0.7064, 0.6096]])\n","Old bias: tensor([0.1600])\n","New bias: tensor([0.2032])\n","\n","--- Epoch 3 ---\n","Prediction: 3.4448001384735107\n","Loss: 2.4186465740203857\n","Weight gradients: tensor([[-6.2208, -9.3312]])\n","Bias gradients: tensor([-3.1104])\n","Old weight: tensor([[0.7064, 0.6096]])\n","New weight: tensor([[0.7686, 0.7029]])\n","Old bias: tensor([0.2032])\n","New bias: tensor([0.2343])\n","\n","--- Epoch 4 ---\n","Prediction: 3.880255937576294\n","Loss: 1.2538267374038696\n","Weight gradients: tensor([[-4.4790, -6.7185]])\n","Bias gradients: tensor([-2.2395])\n","Old weight: tensor([[0.7686, 0.7029]])\n","New weight: tensor([[0.8134, 0.7701]])\n","Old bias: tensor([0.2343])\n","New bias: tensor([0.2567])\n","\n","--- Epoch 5 ---\n","Prediction: 4.193784236907959\n","Loss: 0.6499838829040527\n","Weight gradients: tensor([[-3.2249, -4.8373]])\n","Bias gradients: tensor([-1.6124])\n","Old weight: tensor([[0.8134, 0.7701]])\n","New weight: tensor([[0.8456, 0.8185]])\n","Old bias: tensor([0.2567])\n","New bias: tensor([0.2728])\n","\n","FINAL PARAMETERS\n","Weight: tensor([[0.8456, 0.8185]])\n","Bias: tensor([0.2728])\n"]}],"source":["import torch\n","import torch.nn as nn\n","\n","# 1. Create Linear layer\n","layer = nn.Linear(2, 1)\n","\n","# Set known initial weights and bias\n","with torch.no_grad():\n","    layer.weight.copy_(torch.tensor([[0.5, 0.3]]))\n","    layer.bias.copy_(torch.tensor([0.1]))\n","\n","# Input and target\n","x = torch.tensor([[2.0, 3.0]])\n","target = torch.tensor([[5.0]])\n","\n","# Loss and optimizer\n","criterion = nn.MSELoss()\n","optimizer = torch.optim.SGD(layer.parameters(), lr=0.01)\n","\n","# Print initial parameters\n","print(\"INITIAL PARAMETERS\")\n","print(\"Weight:\", layer.weight.data)\n","print(\"Bias:\", layer.bias.data)\n","\n","# Training loop\n","for epoch in range(5):\n","\n","    # Forward propagation\n","    prediction = layer(x)\n","\n","    # Calculate loss\n","    loss = criterion(prediction, target)\n","\n","    # Clear old gradients\n","    optimizer.zero_grad()\n","\n","    # Backpropagation\n","    loss.backward()\n","\n","    # Show gradients\n","    print(f\"\\n--- Epoch {epoch + 1} ---\")\n","    print(\"Prediction:\", prediction.item())\n","    print(\"Loss:\", loss.item())\n","    print(\"Weight gradients:\", layer.weight.grad)\n","    print(\"Bias gradients:\", layer.bias.grad)\n","\n","    # Save old weights for comparison\n","    old_weight = layer.weight.data.clone()\n","    old_bias = layer.bias.data.clone()\n","\n","    # Update parameters\n","    optimizer.step()\n","\n","    # Print updated parameters\n","    print(\"Old weight:\", old_weight)\n","    print(\"New weight:\", layer.weight.data)\n","\n","    print(\"Old bias:\", old_bias)\n","    print(\"New bias:\", layer.bias.data)\n","\n","print(\"\\nFINAL PARAMETERS\")\n","print(\"Weight:\", layer.weight.data)\n","print(\"Bias:\", layer.bias.data)\n"]},{"cell_type":"markdown","id":"aee50337","metadata":{"papermill":{"duration":0.004283,"end_time":"2026-11-16T13:19:16.379166+00:00","exception":false,"start_time":"2026-11-16T13:19:16.374883+00:00","status":"completed"},"tags":[]},"source":["Here's what happens:\n","\n","- `layer(x)` calculates the output using current weights.\n","- `loss` measures how far the prediction is from the target.\n","- `loss.backward()` calculates gradients for the weights and biases.\n","- `optimizer.step()` updates the parameters to reduce the loss.\n","- `optimizer.zero_grad()` clears accumulated gradients.\n","\n","The Linear layer's weights and biases are learnable parameters.\n","\n","# Embedding\n","\n","PyTorch's `nn.Embedding` is a **lookup table that converts integer IDs into dense, learnable vectors**.\n","\n","## Problem Statement\n","\n","Suppose we have a vocabulary of five words:\n","\n","| Word     | Token ID |\n","| -------- | -------- |\n","| I        | 0        |\n","| love     | 1        |\n","| deep     | 2        |\n","| learning | 3        |\n","| AI       | 4        |\n","\n","A computer cannot directly process words as numerical vectors.\n","\n","One simple solution is one-hot encoding.\n","\n","For example:\n","\n","```\n","\"I\"      = [1, 0, 0, 0, 0]\n","\"love\"   = [0, 1, 0, 0, 0]\n","\"deep\"   = [0, 0, 1, 0, 0]\n","```\n","\n","But one-hot vectors are inefficient for large vocabularies.\n","\n","Instead, we use embeddings. An embedding converts each token ID into a smaller, dense vector.\n","\n","For example:\n","\n","```\n","\"I\"      -> [0.21, 0.45, -0.12]\n","\"love\"   -> [0.32, 0.11,  0.78]\n","\"deep\"   -> [0.91, 0.24, -0.34]\n","\"learning\" -> [0.12, 0.67, 0.55]\n","\"AI\"     -> [0.44, 0.89,  0.13]\n","```\n","\n","These vectors are learnable parameters."]},{"cell_type":"code","execution_count":13,"id":"eb0473eb","metadata":{"execution":{"iopub.execute_input":"2026-11-16T13:19:16.389617Z","iopub.status.busy":"2026-11-16T13:19:16.389145Z","iopub.status.idle":"2026-11-16T13:19:16.3972Z","shell.execute_reply":"2026-11-16T13:19:16.396057Z"},"papermill":{"duration":0.016104,"end_time":"2026-11-16T13:19:16.39958+00:00","exception":false,"start_time":"2026-11-16T13:19:16.383476+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import torch\n","import torch.nn as nn\n","\n","embedding = nn.Embedding(\n","    num_embeddings=5,\n","    embedding_dim=3\n",")"]},{"cell_type":"code","execution_count":14,"id":"49dde1de","metadata":{"execution":{"iopub.execute_input":"2026-11-16T13:19:16.410344Z","iopub.status.busy":"2026-11-16T13:19:16.409965Z","iopub.status.idle":"2026-11-16T13:19:16.418523Z","shell.execute_reply":"2026-11-16T13:19:16.417399Z"},"papermill":{"duration":0.016517,"end_time":"2026-11-16T13:19:16.420589+00:00","exception":false,"start_time":"2026-11-16T13:19:16.404072+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["Parameter containing:\n","tensor([[ 0.2778, -0.4066, -1.4521],\n","        [ 1.3445,  0.9238, -0.2857],\n","        [-0.9106, -0.1499, -0.4121],\n","        [-0.5418, -0.7832,  0.3602],\n","        [-1.0313, -1.5918, -0.9515]], requires_grad=True)"]},"execution_count":14,"metadata":{},"output_type":"execute_result"}],"source":["embedding.weight"]},{"cell_type":"markdown","id":"3309605d","metadata":{"papermill":{"duration":0.004482,"end_time":"2026-11-16T13:19:16.430919+00:00","exception":false,"start_time":"2026-11-16T13:19:16.426437+00:00","status":"completed"},"tags":[]},"source":["There are two important arguments:\n","\n","| Argument           | Meaning                                   |\n","| ------------------ | ----------------------------------------- |\n","| `num_embeddings=5` | Number of unique tokens                   |\n","| `embedding_dim=3`  | Number of dimensions per embedding vector |\n","\n","Internally, PyTorch creates a matrix:\n","\n","$$ W \\in \\mathbb{R}^{5 \\times 3} $$\n","\n","For example:\n","\n","$$ W = \\begin{bmatrix} 0.2 & 0.4 & 0.1\\\\\\ 0.3 & 0.1 & 0.7\\\\\\ 0.9 & 0.2 & 0.3\\\\\\ 0.1 & 0.6 & 0.5\\\\\\ 0.4 & 0.8 & 0.1 \\end{bmatrix} $$\n","\n","Think of this matrix as a dictionary:\n","\n","- Row 0 stores the embedding of token 0.\n","- Row 1 stores the embedding of token 1.\n","- Row 2 stores the embedding of token 2.\n","- And so on.\n","\n","**Embedding weight matrix**\n","\n","| Token ID | Embedding Vector |\n","|----------|------------------|\n","| 0        | [0.2, 0.4, 0.1]  |\n","| 1        | [0.3, 0.1, 0.7]  |\n","| 2        | [0.9, 0.2, 0.3]  |\n","| 3        | [0.1, 0.6, 0.5]  |\n","| 4        | [0.4, 0.8, 0.1]  |\n","\n","Each row represents one token's learnable vector.\n","\n","\n","## Token ID to Embedding"]},{"cell_type":"code","execution_count":15,"id":"d259e53b","metadata":{"execution":{"iopub.execute_input":"2026-11-16T13:19:16.44511Z","iopub.status.busy":"2026-11-16T13:19:16.444699Z","iopub.status.idle":"2026-11-16T13:19:16.453843Z","shell.execute_reply":"2026-11-16T13:19:16.452838Z"},"papermill":{"duration":0.020886,"end_time":"2026-11-16T13:19:16.456221+00:00","exception":false,"start_time":"2026-11-16T13:19:16.435335+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["input_ids = torch.tensor([0, 1, 2, 3])\n","\n","output = embedding(input_ids)"]},{"cell_type":"code","execution_count":16,"id":"b63a86f1","metadata":{"execution":{"iopub.execute_input":"2026-11-16T13:19:16.466867Z","iopub.status.busy":"2026-11-16T13:19:16.46648Z","iopub.status.idle":"2026-11-16T13:19:16.47387Z","shell.execute_reply":"2026-11-16T13:19:16.472879Z"},"papermill":{"duration":0.015163,"end_time":"2026-11-16T13:19:16.475843+00:00","exception":false,"start_time":"2026-11-16T13:19:16.46068+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["tensor([[ 0.2778, -0.4066, -1.4521],\n","        [ 1.3445,  0.9238, -0.2857],\n","        [-0.9106, -0.1499, -0.4121],\n","        [-0.5418, -0.7832,  0.3602]], grad_fn=<EmbeddingBackward0>)"]},"execution_count":16,"metadata":{},"output_type":"execute