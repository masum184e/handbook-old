    "# GPT Block (Decoder Block)\n",
    "\n",
    "def gpt_block(x, causal_mask, num_heads, d_model, dff, dropout_rate=0.1):\n",
    "\n",
    "    # Multi-head self-attention (causal)\n",
    "    attn_output = layers.MultiHeadAttention(num_heads=num_heads, key_dim=d_model // num_heads)(x, x, attention_mask=causal_mask)\n",
    "\n",
    "    attn_output = layers.Dropout(dropout_rate)(attn_output)\n",
    "\n",
    "    # Residual + LayerNorm\n",
    "    x1 = layers.LayerNormalization(epsilon=1e-6)(x + attn_output)\n",
    "\n",
    "    # Feed Forward Network (GPT uses GELU)\n",
    "    ffn = tf.keras.Sequential([layers.Dense(dff, activation=\"gelu\"), layers.Dense(d_model)])\n",
    "\n",
    "    ffn_output = ffn(x1)\n",
    "    ffn_output = layers.Dropout(dropout_rate)(ffn_output)\n",
    "\n",
    "    # Residual + LayerNorm\n",
    "    output = layers.LayerNormalization(epsilon=1e-6)(x1 + ffn_output)\n",
    "\n",
    "    return output"
   ]
