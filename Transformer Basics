    "    input_ids = layers.Input(shape=(max_len,), dtype=tf.int32, name=\"input_ids\")\n",
    "    segment_ids = layers.Input(shape=(max_len,), dtype=tf.int32, name=\"segment_ids\")\n",
    "\n",
    "    sequence_output = bert_encoder(input_ids, segment_ids, vocab_size, type_vocab_size, max_len, num_layers, num_heads, d_model, dff, dropout_rate)\n",
    "\n",
    "    pooled_output = pooler_output(sequence_output)\n",
    "\n",
    "    # Task head (classification example)\n",
    "    x = layers.Dropout(dropout_rate)(pooled_output)\n",
    "    outputs = layers.Dense(num_classes, activation=\"softmax\")(x)\n",
    "\n",
    "    model = Model(inputs=[input_ids, segment_ids], outputs=outputs)\n",
    "\n",
    "    return model\n"
