    "from tensorflow.keras import Model\n",
    "\n",
    "# Full BERT Model Builder\n",
    "\n",
    "def build_bert(vocab_size=30522, type_vocab_size=2, max_len=128, num_layers=12, num_heads=12, d_model=768, dff=3072, num_classes=2, dropout_rate=0.1):\n",
