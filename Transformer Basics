    "\n",
    "    pooled_output = pooler_output(sequence_output)\n",
    "\n",
    "    # Task head (classification example)\n",
    "    x = layers.Dropout(dropout_rate)(pooled_output)\n",
    "    outputs = layers.Dense(num_classes, activation=\"softmax\")(x)\n",
    "\n",
    "    model = Model(inputs=[input_ids, segment_ids], outputs=outputs)\n",
    "\n",
    "    return model\n"
