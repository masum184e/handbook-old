    "# Causal Attention Mask (look-ahead mask)\n",
    "\n",
    "def create_causal_mask(seq_len):\n",
    "    # Lower triangular matrix (1 = allowed, 0 = masked)\n",
    "    mask = tf.linalg.band_part(tf.ones((seq_len, seq_len)), -1, 0)\n",
    "    return mask"
   ]
