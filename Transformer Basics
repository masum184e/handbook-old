    "from tensorflow.keras import Model\n",
    "# Full GPT Model Builder\n",
    "\n",
    "def build_gpt(vocab_size=50257, max_len=128, num_layers=6, num_heads=8, d_model=256, dff=1024, dropout_rate=0.1):\n",
