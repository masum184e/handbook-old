    "from tensorflow.keras import layers, Model\n",
    "\n",
    "def encoder_block(x, num_heads, d_model, dff, dropout_rate=0.1):\n",
    "\n",
    "    # Multi-Head Self Attention\n",
    "    attention_output = layers.MultiHeadAttention(num_heads=num_heads, key_dim=d_model // num_heads)(x, x)\n",
    "\n",
    "    attention_output = layers.Dropout(dropout_rate)(attention_output)\n",
    "\n",
    "    x1 = layers.LayerNormalization(epsilon=1e-6)(x + attention_output)\n",
    "\n",
    "    # Feed Forward\n",
    "    ffn = create_ffn(d_model, dff)\n",
    "    ffn_output = ffn(x1)\n",
    "\n",
    "    ffn_output = layers.Dropout(dropout_rate)(ffn_output)\n",
    "\n",
    "    output = layers.LayerNormalization(epsilon=1e-6)(\n",
    "        x1 + ffn_output\n",
    "    )\n",
    "\n",
    "    return output\n"
   ]
