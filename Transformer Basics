    "# GPT Decoder Stack\n",
    "\n",
    "def gpt_decoder(input_ids, vocab_size, max_len, num_layers, num_heads, d_model, dff, dropout_rate=0.1):\n",
    "\n",
    "    # seq_len = tf.shape(input_ids)[1]\n",
    "    seq_len = max_len\n",
    "\n",
    "    # Embeddings\n",
    "    token_emb = layers.Embedding(vocab_size, d_model)\n",
    "    pos_emb = positional_embedding(max_len, d_model)\n",
    "\n",
    "    token_embeddings = token_emb(input_ids)\n",
    "    position_ids = tf.range(seq_len)[tf.newaxis, :]\n",
    "    position_embeddings = pos_emb(position_ids)\n",
    "\n",
    "    x = token_embeddings + position_embeddings\n",
    "    x = layers.Dropout(dropout_rate)(x)\n",
    "\n",
    "    # Causal mask\n",
    "    causal_mask = create_causal_mask(seq_len)\n",
    "    causal_mask = causal_mask[tf.newaxis, tf.newaxis, :, :]\n",
    "\n",
    "    # Transformer blocks\n",
    "    for _ in range(num_layers):\n",
    "        x = gpt_block(x, causal_mask, num_heads, d_model, dff, dropout_rate)\n",
    "\n",
    "    return x"
   ]
