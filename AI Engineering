shell.execute_reply":"2026-11-20T12:25:41.225329Z"},"papermill":{"duration":0.019615,"end_time":"2026-11-20T12:25:41.228693+00:00","exception":false,"start_time":"2026-11-20T12:25:41.209078+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["result = selected_tool(**tool_args)"]},{"cell_type":"code","execution_count":52,"id":"247f70fd","metadata":{"execution":{"iopub.execute_input":"2026-11-20T12:25:41.252394Z","iopub.status.busy":"2026-11-20T12:25:41.25204Z","iopub.status.idle":"2026-11-20T12:25:41.259566Z","shell.execute_reply":"2026-11-20T12:25:41.25838Z"},"papermill":{"duration":0.022742,"end_time":"2026-11-20T12:25:41.261612+00:00","exception":false,"start_time":"2026-11-20T12:25:41.23887+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["{'results': [{'id': 'P001', 'name': 'Laptop', 'price': 1200, 'stock': 10}]}"]},"execution_count":52,"metadata":{},"output_type":"execute_result"}],"source":["result"]},{"cell_type":"markdown","id":"67fa0f0d","metadata":{"papermill":{"duration":0.01006,"end_time":"2026-11-20T12:25:41.281719+00:00","exception":false,"start_time":"2026-11-20T12:25:41.271659+00:00","status":"completed"},"tags":[]},"source":["### Tool Result\n","\n","The application sends the result back to the model. The LLM uses the returned data to create a natural-language answer.\n","\n","This is why tool calling is a multi-step interaction, not just a single LLM response.&#x20;\n"]},{"cell_type":"code","execution_count":53,"id":"4e15da7a","metadata":{"execution":{"iopub.execute_input":"2026-11-20T12:25:41.306355Z","iopub.status.busy":"2026-11-20T12:25:41.305301Z","iopub.status.idle":"2026-11-20T12:25:41.311104Z","shell.execute_reply":"2026-11-20T12:25:41.310099Z"},"papermill":{"duration":0.020694,"end_time":"2026-11-20T12:25:41.313247+00:00","exception":false,"start_time":"2026-11-20T12:25:41.292553+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import json\n","\n","messages.append({\n","                \"role\": \"tool\",\n","                \"tool_call_id\": tool_id,\n","                \"content\": json.dumps(result)\n","            })"]},{"cell_type":"code","execution_count":54,"id":"6dfed737","metadata":{"execution":{"iopub.execute_input":"2026-11-20T12:25:41.336193Z","iopub.status.busy":"2026-11-20T12:25:41.335814Z","iopub.status.idle":"2026-11-20T12:25:41.343203Z","shell.execute_reply":"2026-11-20T12:25:41.342032Z"},"papermill":{"duration":0.021608,"end_time":"2026-11-20T12:25:41.345193+00:00","exception":false,"start_time":"2026-11-20T12:25:41.323585+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["[{'role': 'system',\n","  'content': 'You are a helpful shopping assistant. Use available tools when necessary.'},\n"," {'role': 'user', 'content': 'Find laptop'},\n"," {'role': 'tool',\n","  'tool_call_id': '02m07k50j',\n","  'content': '{\"results\": [{\"id\": \"P001\", \"name\": \"Laptop\", \"price\": 1200, \"stock\": 10}]}'}]"]},"execution_count":54,"metadata":{},"output_type":"execute_result"}],"source":["messages"]},{"cell_type":"code","execution_count":55,"id":"6b70f0c6","metadata":{"execution":{"iopub.execute_input":"2026-11-20T12:25:41.368343Z","iopub.status.busy":"2026-11-20T12:25:41.367952Z","iopub.status.idle":"2026-11-20T12:25:43.810961Z","shell.execute_reply":"2026-11-20T12:25:43.810072Z"},"papermill":{"duration":2.457663,"end_time":"2026-11-20T12:25:43.813325+00:00","exception":false,"start_time":"2026-11-20T12:25:41.355662+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["response = llm_with_tools.invoke(messages)"]},{"cell_type":"code","execution_count":56,"id":"9e8ab929","metadata":{"execution":{"iopub.execute_input":"2026-11-20T12:25:43.835646Z","iopub.status.busy":"2026-11-20T12:25:43.835321Z","iopub.status.idle":"2026-11-20T12:25:43.842392Z","shell.execute_reply":"2026-11-20T12:25:43.841286Z"},"papermill":{"duration":0.020441,"end_time":"2026-11-20T12:25:43.844444+00:00","exception":false,"start_time":"2026-11-20T12:25:43.824003+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["I found a laptop in our catalog:\n","\n","**Laptop** (ID: P001)\n","- **Price:** $1,200\n","- **Stock:** 10 units available\n","\n","Would you like more details about this laptop, or would you like to calculate the total for a specific quantity?"],"text/plain":["<IPython.core.display.HTML object>"]},"metadata":{},"output_type":"display_data"}],"source":["from IPython.display import display, HTML\n","\n","display(HTML(response.content))"]},{"cell_type":"markdown","id":"c79c4cf0","metadata":{"papermill":{"duration":0.010481,"end_time":"2026-11-20T12:25:43.865766+00:00","exception":false,"start_time":"2026-11-20T12:25:43.855285+00:00","status":"completed"},"tags":[]},"source":["\n","## Tool Calling Architecture\n","\n","Let's use an example:\n","\n","> User: Find Laptop\n","\n","The application has a tool:\n","\n","```py\n","def search_products(query: str):    \n","    ...\n","```\n","\n","![Inside Tool Calling](https://raw.githubusercontent.com/masum184e/handbook/main/static/img/ai-engineering/inside_tool_calling.png)\n","\n","1. **User sends a message**  \n","2. **Application sends the prompt and tool definitions to the LLM**  \n","    The request contains the user's message and the available tool schema.\n","3. **LLM decides whether to call a tool**\n","\n","    The model identifies that live weather information is required.\n","\n","   It generates a structured tool-call request:\n","   ```\n","   {\n","     \"name\": \"search_product\",\n","     \"args\": {'query': 'laptop'}\n","   }\n","   ```\n","4. **Application receives the tool-call request**\n","\n","   The application identifies the requested tool and parses its arguments.\n","5. **Application executes the tool**\n","   ```\n","   search_products(query=\"laptop\")\n","   ```\n","   The function fetches weather information from the weather service.\n","6. **Tool result is returned to the LLM**\n","   ```\n","   {\n","     \"temperature\": 31,\n","     \"condition\": \"Sunny\"\n","   }\n","   ```\n","7. **LLM generates the final answer**\n","   ```\n","   The current weather in Dhaka is 31°C and sunny.\n","   ```\n","\n","The fundamental workflow is:\n","\n","$$ \\text{User} \\rightarrow \\text{LLM} \\rightarrow \\text{Tool Call} $$\n","\n","$$ \\text{Application} \\rightarrow \\text{Tool Execution} \\rightarrow \\text{Tool Result} $$\n","\n","$$ \\text{LLM} \\rightarrow \\text{Final Answer} $$\n","\n","\n","\n","## Tool Calling Control\n","\n","This is an important API configuration that you should understand deeply.\n","\n","`tool_choice` controls how the model is allowed to use tools.\n","\n","There are four common modes.\n","\n","- `tool_choice=\"auto\"`\n","    - The model decides whether to call a tool.\n","    - Example: User asks, \"What is the laptop price?\" The model may call `get_product`.\n","- `tool_choice=\"required\"`\n","    - The model must call at least one tool.\n","    - Example: You want the model to always query the database for product information.\n","\n","- **Forced Function**  \n","    The model must call a specific function.\n","    ```py\n","    tool_choice={    \n","        \"type\": \"function\",    \n","        \"name\": \"get_product\"\n","        }\n","    ```\n","    Example: Your application explicitly wants a product lookup.\n","- `tool_choice=\"none\"`\n","    - The model must not call any tools.\n","    - Example: You want the model to respond only using its existing conversational context.\n","\n","These options are documented in the OpenAI function-calling guide.\n","\n","**When should you use each?**\n","\n","| Situation                           | Tool choice                             |\n","| ----------------------------------- | --------------------------------------- |\n","| General-purpose chatbot             | `auto`                                  |\n","| Database-grounded response required | `required` or enforced application flow |\n","| Specific function execution         | Forced function                         |\n","| Pure conversational response        | `none`                                  |\n","\n","Important: `required` doesn't necessarily mean the model must call a particular tool. It may select any eligible tool."]},{"cell_type":"markdown","id":"5453cf7a","metadata":{"papermill":{"duration":0.010086,"end_time":"2026-11-20T12:25:43.885778+00:00","exception":false,"start_time":"2026-11-20T12:25:43.875692+00:00","status":"completed"},"tags":[]},"source":["## Parallel Tool Calling vs Sequential Tool Calling\n","\n","### Parallel tool calling\n","\n","Parallel tool calling means the LLM requests multiple independent tools in the same response.\n","\n","Example:\n","\n","> What is the weather in Dhaka and Chittagong?\n","\n","The model can generate:\n","\n","```json\n","[\n","  {\n","    \"name\": \"get_weather\",\n","    \"arguments\": {\n","      \"city\": \"Dhaka\"\n","    }\n","  },\n","  {\n","    \"name\": \"get_weather\",\n","    \"arguments\": {\n","      \"city\": \"Chittagong\"\n","    }\n","  }\n","]\n","```\n","\n","Both tools can run at the same time."]},{"cell_type":"code","execution_count":57,"id":"6affccc9","metadata":{"execution":{"iopub.execute_input":"2026-11-20T12:25:43.90731Z","iopub.status.busy":"2026-11-20T12:25:43.906849Z","iopub.status.idle":"2026-11-20T12:25:43.912505Z","shell.execute_reply":"2026-11-20T12:25:43.911383Z"},"papermill":{"duration":0.019235,"end_time":"2026-11-20T12:25:43.914745+00:00","exception":false,"start_time":"2026-11-20T12:25:43.89551+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# import asyncio\n","\n","# results = await asyncio.gather(\n","#     get_weather_async(\"Dhaka\"),\n","#     get_weather_async(\"Chittagong\")\n","# )"]},{"cell_type":"markdown","id":"e6305c17","metadata":{"papermill":{"duration":0.009733,"end_time":"2026-11-20T12:25:43.934533+00:00","exception":false,"start_time":"2026-11-20T12:25:43.9248+00:00","status":"completed"},"tags":[]},"source":["The benefit is lower latency when calls are independent.\n","\n","### Sequential tool calling\n","\n","Sequential tool calling means one tool's result is required before the next tool can be called.\n","\n","Example:\n","\n","> Find the laptop price and calculate the price for 5 laptops.\n","\n","Execution:\n","\n","```\n","Step 1: get_product(\"P001\")\n","               |\n","               v\n","Step 2: Receive price = 1200\n","               |\n","               v\n","Step 3: calculate_total(1200, 5)\n","               |\n","               v\n","Step 4: Receive total = 6000\n","               |\n","               v\n","Step 5: Generate final answer\n","```\n","\n","The second tool depends on the first tool's output.\n","\n","### **Comparison**\n","\n","| Feature        | Parallel               | Sequential               |\n","| -------------- | ---------------------- | ------------------------ |\n","| Execution      | Concurrent             | One after another        |\n","| Dependency     | Independent tools      | Dependent tools          |\n","| Latency        | Usually lower          | Usually higher           |\n","| Example        | Weather in two cities  | Get price then calculate |\n","| Agent behavior | Multiple calls at once | Iterative calls          |\n","\n","**Interview point:** Parallel tool calling is not the same as an agent executing a sequence of dependent actions. A model may request multiple independent tool calls in one response, or it may request another tool after receiving a prior tool's result.\n","\n","## Tool Calling vs AI Agent vs MCP\n","\n","This is one of the most frequently misunderstood areas in AI engineering.\n","\n","### Tool calling\n","\n","Tool calling is the mechanism by which an LLM requests an external capability.\n","\n","Example:\n","\n","```\n","get_product(product_id=\"P001\")\n","```\n","\n","### AI agent\n","\n","An AI agent is a system that uses an LLM to select actions, observe results, and continue working toward a goal.\n","\n","Example:\n","\n","```\n","User:\n","Find the cheapest laptop and recommend it.\n","\n","Agent:\n","1. Search laptop catalog.\n","2. Retrieve laptop prices.\n","3. Compare products.\n","4. Choose the cheapest.\n","5. Generate recommendation.\n","```\n","\n","An agent may use tool calling, but an agent also includes orchestration, state, control flow, and possibly planning.\n","\n","### MCP\n","\n","MCP stands for Model Context Protocol.\n","\n","It is a protocol that standardizes how AI applications connect to external tools and resources.\n","\n","For example:\n","\n","```\n","External AI Agent\n","       |\n","       v\n","    MCP Client\n","       |\n","       v\n","    MCP Server\n","       |\n","       v\n","  MongoDB Tools\n","       |\n","       v\n","    MongoDB\n","```\n","\n","An MCP server could expose:\n","\n","```\n","search_products\n","get_product\n","get_inventory\n","```\n","\n","An AI application connected to that MCP server can discover and invoke the tools.\n","\n","### Comparison\n","\n","| Tool Calling             | AI Agent                    | MCP                              |\n","| ------------------------ | --------------------------- | -------------------------------- |\n","| An interaction mechanism | An AI-driven system         | A communication protocol         |\n","| Requests tools           | Uses tools to pursue goals  | Standardizes tool access         |\n","| Can be one-step          | Often multi-step            | Does not itself define reasoning |\n","| Can work without MCP     | Can use MCP or direct tools | Can be used by agents            |\n","\n","**Important architectural insight**\n","\n","* You can build an agent without MCP.\n","* You can build an MCP server without an agent.\n","* You can build an AI agent that uses MCP tools.\n","\n","These are related concepts, but they are not the same thing."]},{"cell_type":"markdown","id":"e36af067","metadata":{"papermill":{"duration":0.009679,"end_time":"2026-11-20T12:25:43.954486+00:00","exception":false,"start_time":"2026-11-20T12:25:43.944807+00:00","status":"completed"},"tags":[]},"source":["# ReAct Agent\n","\n","ReAct stands for:\n","\n","- **Re** — Reasoning\n","- **Act** — Acting\n","\n","ReAct is an agent paradigm in which a Large Language Model (LLM) alternates between reasoning about a problem and taking actions using external tools, then observes the results of those actions to decide what to do next.\n","\n","The ReAct framework was introduced in the research paper:\n","\n","ReAct: Synergizing Reasoning and Acting in Language Models\n","\n","The central idea:\n","\n","> Instead of answering a question immediately, the LLM can think about what information it needs, perform an action, observe the result, and continue until it can provide a final answer.\n","\n","For example, suppose a user asks:\n","\n","\"What is the population of Bangladesh, and what is 10% of that population?\"\n","\n","A normal LLM might try to answer from its internal knowledge.\n","\n","A ReAct Agent might:\n","\n","1. Reason that it needs the latest population.\n","2. Use a web search tool.\n","3. Observe the search result.\n","4. Extract the population.\n","5. Use a calculator tool to calculate 10%.\n","6. Observe the result.\n","7. Return the final answer.\n","\n","This is the key difference between a normal LLM and a ReAct Agent.\n","\n","## Architecture\n","\n","The architecture consists of five primary components.\n","\n","| Component   | Responsibility                     |\n","| ----------- | ---------------------------------- |\n","| LLM         | Decides what to do                 |\n","| Reasoning   | Determines the next step           |\n","| Action      | Executes a tool                    |\n","| Observation | Receives the tool output           |\n","| Agent Loop  | Repeats the cycle until completion |\n","\n","![React Agent Architecture](react_agent_architecture.png)\n","\n","\n","The most important part is the loop between the LLM and the tools.\n","\n","The agent is not limited to a single tool call. It can perform multiple actions, depending on the task.\n","\n","## The ReAct Loop\n","\n","The classic ReAct framework follows a sequence of three steps.\n","\n","- **Thought (Reasoning)**: The LLM determines what information is missing or which action is needed.\n","- **Action**: The agent calls a tool such as a search engine, database query, calculator, or API.\n","- **Observation**: The agent receives the tool's result and uses it to determine the next step.\n","\n","Repeat the loop until the task is complete.\n","\n","**Example of the ReAct loop**\n","\n","User:\n","\n","> Find the price of a laptop that costs $800 after a 15% discount.\n","\n","The agent's conceptual process:\n","\n","```\n","\n","User:\n","Find the price of a laptop that costs $800 after a 15% discount.\n","\n","Thought:\n","I need to calculate the discount amount.\n","\n","Action:\n","Calculator(800 * 0.15)\n","\n","Observation:\n","120\n","\n","Thought:\n","Now I need to subtract the discount from the original price.\n","\n","Action:\n","Calculator(800 - 120)\n","\n","Observation:\n","680\n","\n","Final Answer:\n","The laptop costs $680 after the discount.\n","\n","```\n","\n","Notice that the agent takes two actions, each using the previous observation.\n","\n","This is a multi-step ReAct process.\n","\n","The “Thought” representation above is illustrative. Modern agents may use structured tool calls rather than exposing their internal reasoning in plain text."]},{"cell_type":"code","execution_count":58,"id":"ede720ea","metadata":{"execution":{"iopub.execute_input":"2026-11-20T12:25:43.975982Z","iopub.status.busy":"2026-11-20T12:25:43.975593Z","iopub.status.idle":"2026-11-20T12:25:44.009212Z","shell.execute_reply":"2026-11-20T12:25:44.007926Z"},"papermill":{"duration":0.047303,"end_time":"2026-11-20T12:25:44.01172+00:00","exception":false,"start_time":"2026-11-20T12:25:43.964417+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from langchain_core.tools import tool\n","\n","@tool\n","def get_product(product_id: str) -> dict:\n","    \"\"\"Retrieve product details using its product ID.\"\"\"\n","    products = {\n","        \"P001\": {\"name\": \"Laptop\", \"price\": 75000},\n","        \"P002\": {\"name\": \"Mouse\", \"price\": 1200}\n","    }\n","\n","    return products.get(product_id, {\"error\": \"Product not found\"})\n","\n","\n","@tool\n","def calculate_total(price: float, quantity: int) -> float:\n","    \"\"\"Calculate total price from unit price and quantity.\"\"\"\n","    return price * quantity"]},{"cell_type":"code","execution_count":59,"id":"41c6c176","metadata":{"execution":{"iopub.execute_input":"2026-11-20T12:25:44.035061Z","iopub.status.busy":"2026-11-20T12:25:44.034285Z","iopub.status.idle":"2026-11-20T12:25:51.776135Z","shell.execute_reply":"2026-11-20T12:25:51.775187Z"},"papermill":{"duration":7.756484,"end_time":"2026-11-20T12:25:51.778497+00:00","exception":false,"start_time":"2026-11-20T12:25:44.022013+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from langchain.agents import create_agent\n","\n","# Register tools\n","tools = [\n","    get_product,\n","    calculate_total\n","]\n","\n","# Create agent\n","agent = create_agent(\n","    model=llm,\n","    tools=tools,\n","    system_prompt=(\n","        \"You are a helpful AI assistant. \"\n","        \"Use tools when necessary. \"\n","        \"Verify calculations using the calculator tool. \"\n","        \"Answer clearly and concisely.\"\n","    )\n",")\n","\n","# Execute\n","response = agent.invoke({\n","    \"messages\": [\n","        {\n","            \"role\": \"user\",\n","            \"content\": (\n","                \"Find the population of Bangladesh \"\n","                \"and calculate 10% of it.\"\n","            )\n","        }\n","    ]\n","})\n"]},{"cell_type":"code","execution_count":60,"id":"378f0eb2","metadata":{"execution":{"iopub.execute_input":"2026-11-20T12:25:51.800502Z","iopub.status.busy":"2026-11-20T12:25:51.800085Z","iopub.status.idle":"2026-11-20T12:25:51.806073Z","shell.execute_reply":"2026-11-20T12:25:51.804856Z"},"papermill":{"duration":0.019654,"end_time":"2026-11-20T12:25:51.808183+00:00","exception":false,"start_time":"2026-11-20T12:25:51.788529+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Wait — that tool multiplies price × quantity, so I used it incorrectly. Let me just compute 10% directly:\n","\n","**10% of 170,000,000 = 17,000,000**\n","\n","So, 10% of Bangladesh's population is approximately **17 million people**.\n"]}],"source":["# Display the final response\n","print(response[\"messages\"][-1].content)"]},{"cell_type":"markdown","id":"fb9843c3","metadata":{"papermill":{"duration":0.009992,"end_time":"2026-11-20T12:25:51.828246+00:00","exception":false,"start_time":"2026-11-20T12:25:51.818254+00:00","status":"completed"},"tags":[]},"source":["![ReAct Execution](react_agent_execution.png)\n","\n","The key idea is that the framework automatically manages the cycle:\n","\n","1. Call LLM.\n","2. Check for tool calls.\n","3. Execute requested tools.\n","4. Append tool results to conversation state.\n","5. Call LLM again.\n","6. Finish when no more tool calls are requested.\n","\n","This is the ReAct pattern in action.&#x20;\n","\n","## ReAct Agent with LangGraph\n","\n","LangGraph is particularly useful when you want to control an agent's workflow explicitly.\n","\n","A classic ReAct graph has two main nodes:\n","\n","- `agent`: Calls the LLM.\n","- `tools`: Executes tools.\n","\n","The graph has a conditional edge:\n","\n","- If the model requested tools → go to the tools node.\n","- If the model returned a final response → end.\n","\n","![React Agent with Langgraph](react_agent_langgraph.png)\n","\n","LangGraph's underlying graph can be customized with state, conditional routin