    "# Stack Multiple Residual Blocks\n",
    "def make_layer(x, filters, num_blocks, strides):\n",
    "\n",
    "    x = residual_block(x, filters, strides)\n",
    "\n",
    "    for _ in range(1, num_blocks):\n",
    "        x = residual_block(x, filters, strides=1)\n",
    "\n",
    "    return x"
   ]
