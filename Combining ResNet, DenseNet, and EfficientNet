    "from tensorflow.keras.layers import DepthwiseConv2D, Activation, Add\n",
    "\n",
    "def mbconv_block(x, out_channels, kernel_size, strides, expand_ratio, se_ratio=0.25):\n",
    "\n",
    "    input_channels = x.shape[-1]\n",
    "\n",
    "    shortcut = x\n",
    "\n",
    "    # Expansion phase\n",
    "    expanded_channels = input_channels * expand_ratio\n",
    "\n",
    "    if expand_ratio != 1:\n",
    "\n",
    "        x = Conv2D(expanded_channels, kernel_size=1, padding=\"same\", use_bias=False)(x)\n",
    "\n",
    "        x = BatchNormalization()(x)\n",
    "\n",
    "        x = Activation(\"swish\")(x)\n",
    "\n",
    "    # Depthwise convolution\n",
    "    x = DepthwiseConv2D(kernel_size, strides=strides, padding=\"same\", use_bias=False)(x)\n",
    "\n",
    "    x = BatchNormalization()(x)\n",
    "\n",
    "    x = Activation(\"swish\")(x)\n",
    "\n",
    "    # Squeeze-and-Excitation\n",
    "    x = se_block(x, se_ratio)\n",
    "\n",
    "    # Projection phase\n",
    "    x = Conv2D(out_channels, kernel_size=1, padding=\"same\", use_bias=False)(x)\n",
    "\n",
    "    x = BatchNormalization()(x)\n",
    "\n",
    "    # Residual connection\n",
    "    if strides == 1 and input_channels == out_channels:\n",
    "        x = Add()([shortcut, x])\n",
    "\n",
    "    return x"
   ]
