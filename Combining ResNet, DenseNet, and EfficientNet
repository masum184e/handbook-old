    "from tensorflow.keras.layers import Input, GlobalAveragePooling2D\n",
    "from tensorflow.keras.models import Model\n",
    "\n",
    "def build_efficientnet_b0(input_shape=(224, 224, 3), num_classes=1000):\n",
    "\n",
    "    inputs = Input(shape=input_shape)\n",
    "\n",
    "    # Stem\n",
    "    x = conv_bn_act(\n",
    "        inputs,\n",
    "        filters=32,\n",
    "        kernel_size=3,\n",
    "        strides=2\n",
    "    )\n",
    "\n",
    "    # Stage 1\n",
    "    x = mbconv_block(\n",
    "        x,\n",
    "        out_channels=16,\n",
    "        kernel_size=3,\n",
    "        strides=1,\n",
    "        expand_ratio=1\n",
    "    )\n",
    "\n",
    "    # Stage 2\n",
    "    x = mbconv_block(\n",
    "        x,\n",
    "        out_channels=24,\n",
    "        kernel_size=3,\n",
    "        strides=2,\n",
    "        expand_ratio=6\n",
    "    )\n",
    "\n",
    "    x = mbconv_block(\n",
    "        x,\n",
    "        out_channels=24,\n",
    "        kernel_size=3,\n",
    "        strides=1,\n",
    "        expand_ratio=6\n",
    "    )\n",
    "\n",
    "    # Stage 3\n",
    "    x = mbconv_block(\n",
    "        x,\n",
    "        out_channels=40,\n",
    "        kernel_size=5,\n",
    "        strides=2,\n",
    "        expand_ratio=6\n",
    "    )\n",
    "\n",
    "    x = mbconv_block(\n",
    "        x,\n",
    "        out_channels=40,\n",
    "        kernel_size=5,\n",
    "        strides=1,\n",
    "        expand_ratio=6\n",
    "    )\n",
    "\n",
    "    # Stage 4\n",
    "    for i in range(3):\n",
    "\n",
    "        x = mbconv_block(\n",
    "            x,\n",
    "            out_channels=80,\n",
    "            kernel_size=3,\n",
    "            strides=2 if i == 0 else 1,\n",
    "            expand_ratio=6\n",
    "        )\n",
    "\n",
    "    # Stage 5\n",
    "    for i in range(3):\n",
    "\n",
    "        x = mbconv_block(\n",
    "            x,\n",
    "            out_channels=112,\n",
    "            kernel_size=5,\n",
    "            strides=1,\n",
    "            expand_ratio=6\n",
    "        )\n",
    "\n",
    "    # Stage 6\n",
    "    for i in range(4):\n",
    "\n",
    "        x = mbconv_block(\n",
    "            x,\n",
    "            out_channels=192,\n",
    "            kernel_size=5,\n",
    "            strides=2 if i == 0 else 1,\n",
    "            expand_ratio=6\n",
    "        )\n",
    "\n",
    "    # Stage 7\n",
    "    x = mbconv_block(\n",
    "        x,\n",
    "        out_channels=320,\n",
    "        kernel_size=3,\n",
    "        strides=1,\n",
    "        expand_ratio=6\n",
    "    )\n",
    "\n",
    "    # Head\n",
    "    x = conv_bn_act(\n",
    "        x,\n",
    "        filters=1280,\n",
    "        kernel_size=1\n",
    "    )\n",
    "\n",
    "    x = GlobalAveragePooling2D()(x)\n",
    "\n",
    "    outputs = Dense(\n",
    "        num_classes,\n",
    "        activation=\"softmax\"\n",
    "    )(x)\n",
    "\n",
    "    model = Model(inputs, outputs)\n",
    "\n",
    "    return model\n",
    "\n",
    "model = build_efficientnet_b0(\n",
    "    input_shape=(224, 224, 3),\n",
    "    num_classes=1000\n",
    ")\n",
    "\n",
    "model.summary()"
