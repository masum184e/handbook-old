    "from tensorflow.keras.layers import Input, GlobalAveragePooling2D, Dense\n",
    "from tensorflow.keras.models import Model\n",
    "\n",
    "def build_densenet121(input_shape=(224, 224, 3), num_classes=1000, growth_rate=32):\n",
    "\n",
    "    inputs = Input(shape=input_shape)\n",
    "\n",
    "    # Initial Convolution\n",
    "    x = Conv2D(64, kernel_size=7, strides=2, padding=\"same\", use_bias=False)(inputs)\n",
    "\n",
    "    x = BatchNormalization()(x)\n",
    "    x = ReLU()(x)\n",
    "\n",
    "    x = tf.keras.layers.MaxPooling2D(pool_size=3, strides=2, padding=\"same\")(x)\n",
    "\n",
    "    # Dense Block 1\n",
    "    x = dense_block(x, 6, growth_rate)\n",
    "    x = transition_layer(x)\n",
    "\n",
    "    # Dense Block 2\n",
    "    x = dense_block(x, 12, growth_rate)\n",
    "    x = transition_layer(x)\n",
    "\n",
    "    # Dense Block 3\n",
    "    x = dense_block(x, 24, growth_rate)\n",
    "    x = transition_layer(x)\n",
    "\n",
    "    # Dense Block 4\n",
    "    x = dense_block(x, 16, growth_rate)\n",
    "\n",
    "    # Classification Head\n",
    "    x = BatchNormalization()(x)\n",
    "    x = ReLU()(x)\n",
    "\n",
    "    x = GlobalAveragePooling2D()(x)\n",
    "\n",
    "    outputs = Dense(num_classes,activation=\"softmax\")(x)\n",
    "\n",
    "    model = Model(inputs, outputs)\n",
    "\n",
    "    return model\n",
    "\n",
    "model = build_densenet121(input_shape=(224, 224, 3), num_classes=1000)\n",
    "\n",
    "model.summary()"
   ]
