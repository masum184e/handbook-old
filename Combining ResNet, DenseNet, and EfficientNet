    "from tensorflow.keras.layers import Conv2D, BatchNormalization, ReLU, Concatenate\n",
    "\n",
    "def dense_layer(x, growth_rate):\n",
    "\n",
    "    out = BatchNormalization()(x)\n",
    "    out = ReLU()(out)\n",
    "\n",
    "    out = Conv2D(growth_rate, kernel_size=3, padding=\"same\", use_bias=False)(out)\n",
    "\n",
    "    # Concatenate input with new features\n",
    "    out = Concatenate()([x, out])\n",
    "\n",
    "    return out"
   ]
