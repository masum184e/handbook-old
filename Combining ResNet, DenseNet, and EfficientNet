    "from tensorflow.keras.layers import Input, MaxPooling2D, GlobalAveragePooling2D, Dense\n",
    "from tensorflow.keras.models import Model\n",
    "\n",
    "# Build ResNet34\n",
    "def build_resnet34(input_shape=(224, 224, 3), num_classes=1000):\n",
    "\n",
    "    inputs = Input(shape= input_shape)\n",
    "\n",
    "    # Initial Stem\n",
    "    x = Conv2D(64, kernel_size=7, strides=2, padding=\"same\", use_bias=False)(inputs)\n",
    "\n",
    "    x = BatchNormalization()(x)\n",
    "    x = ReLU()(x)\n",
    "\n",
    "    x = MaxPooling2D(pool_size=3, strides=2, padding=\"same\")(x)\n",
    "\n",
    "    # Residual Stages\n",
    "    x = make_layer(x, 64, 3, strides=1)\n",
    "    x = make_layer(x, 128, 4, strides=2)\n",
    "    x = make_layer(x, 256, 6, strides=2)\n",
    "    x = make_layer(x, 512, 3, strides=2)\n",
    "\n",
    "    # Classification Head\n",
    "    x = GlobalAveragePooling2D()(x)\n",
    "\n",
    "    outputs = Dense(num_classes, activation=\"softmax\")(x)\n",
    "\n",
    "    model = Model(inputs, outputs)\n",
    "\n",
    "    return model\n",
    "\n",
    "\n",
    "model = build_resnet34(input_shape=(224, 224, 3), num_classes=1000)\n",
    "\n",
    "model.summary()"
   ]
