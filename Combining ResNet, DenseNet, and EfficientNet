    "$$\n",
    "32×32×8\n",
    "$$\n",
    "\n",
    "### Dense Layer 1\n",
    "\n",
    "Adds 4 feature maps:\n",
    "$$\n",
    "32×32×12\n",
    "$$\n",
    "\n",
    "### Dense Layer 2\n",
    "\n",
    "Receives all previous outputs:\n",
    "\n",
    "```text\n",
    "[8 original + 4 from layer1]\n",
    "```\n",
    "\n",
    "Adds 4 more:\n",
    "\n",
    "$$\n",
    "32×32×16\n",
    "$$\n",
    "\n",
    "### Dense Layer 3\n",
    "\n",
