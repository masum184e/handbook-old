    "%%writefile main.cpp\n",
    "\n",
    "#include <iostream>\n",
    "#include <vector>\n",
    "using namespace std;\n",
    "\n",
    "double lagrangeInterpolation(\n",
    "    vector<double> x,\n",
    "    vector<double> y,\n",
    "    double xp\n",
    ") {\n",
    "    int n = x.size();\n",
    "    double yp = 0;\n",
    "\n",
    "    for (int i = 0; i < n; i++) {\n",
    "        double term = y[i];\n",
    "\n",
    "        for (int j = 0; j < n; j++) {\n",
    "            if (i != j) {\n",
    "                term *= (xp - x[j]) / (x[i] - x[j]);\n",
    "            }\n",
    "        }\n",
    "\n",
    "        yp += term;\n",
    "    }\n",
    "\n",
    "    return yp;\n",
    "}\n",
    "\n",
    "int main() {\n",
    "    vector<double> x = {1, 2, 3};\n",
    "    vector<double> y = {1, 4, 9};\n",
    "\n",
    "    double xp = 2.5;\n",
    "\n",
    "    cout << \"Interpolated value = \"\n",
    "         << lagrangeInterpolation(x, y, xp)\n",
    "         << endl;\n",
    "\n",
    "    return 0;\n",
    "}"
