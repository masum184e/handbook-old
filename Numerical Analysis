    "\n",
    "## Example Workthrough\n",
    "\n",
    "Find the root of:\n",
    "\n",
    "$$\n",
    "x^3-x-2=0\n",
    "$$\n",
    "\n",
    "### Iteration 0\n",
    "\n",
    "Define:\n",
    "\n",
    "$$\n",
    "f(x)=x^3-x-2\n",
    "$$\n",
    "\n",
    "Choose:\n",
    "\n",
    "$$\n",
    "a=1,\\quad b=2\n",
    "$$\n",
    "\n",
    "Calculate:\n",
    "\n",
    "$$\n",
    "f(1)=1-1-2=-2\n",
    "$$\n",
    "\n",
    "$$\n",
    "f(2)=8-2-2=4\n",
    "$$\n",
    "\n",
    "Since:\n",
    "\n",
    "$$\n",
    "f(1)f(2)=(-2)(4)=-8<0\n",
    "$$\n",
    "\n",
    "a root exists in $[1,2]$.\n",
    "\n",
    "### Iteration 1\n",
    "\n",
    "Midpoint:\n",
    "\n",
    "$$\n",
    "m=\\frac{1+2}{2}=1.5\n",
    "$$\n",
    "\n",
    "Evaluate:\n",
    "\n",
    "$$\n",
    "f(1.5)=1.5^3-1.5-2\n",
    "$$\n",
    "\n",
    "$$\n",
    "=3.375-3.5\n",
    "$$\n",
    "\n",
    "$$\n",
    "=-0.125\n",
    "$$\n",
