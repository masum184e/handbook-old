    "| 2   | 4      |\n",
    "\n",
    "Since:\n",
    "\n",
    "$$\n",
    "f(1.5)f(2)<0\n",
    "$$\n",
    "\n",
    "root lies in:\n",
    "\n",
    "$$\n",
    "[1.5,2]\n",
    "$$\n",
    "\n",
    "### Iteration 2\n",
    "\n",
    "New interval:\n",
    "\n",
    "$$\n",
    "[1.5,2]\n",
    "$$\n",
