    "%%writefile main.cpp\n",
    "\n",
    "#include <iostream>\n",
    "#include <cmath>\n",
    "using namespace std;\n",
    "\n",
    "// Example function: f(x) = x^3 - x - 2\n",
    "double f(double x) {\n",
    "    return x * x * x - x - 2;\n",
    "}\n",
    "\n",
    "double bisection(double a, double b, double tol = 1e-6, int maxIter = 1000) {\n",
    "    if (f(a) * f(b) >= 0) {\n",
    "        throw invalid_argument(\"f(a) and f(b) must have opposite signs\");\n",
    "    }\n",
    "\n",
    "    double m;\n",
    "\n",
    "    for (int i = 0; i < maxIter; i++) {\n",
    "        m = (a + b) / 2.0;\n",
    "\n",
    "        // compute the absolute value of a floating-point number\n",
    "        if (fabs(f(m)) < tol || (b - a) < 2 * tol)\n",
    "            return m;\n",
    "\n",
    "        if (f(a) * f(m) < 0)\n",
    "            b = m;\n",
    "        else\n",
    "            a = m;\n",
    "    }\n",
    "\n",
    "    return m;\n",
    "}\n",
    "\n",
    "int main() {\n",
    "    double root = bisection(1, 2);\n",
    "    cout << \"Root = \" << root << endl;\n",
    "    return 0;\n",
    "}"
