    "%%writefile main.cpp\n",
    "\n",
    "#include <iostream>\n",
    "#include <vector>\n",
    "#include <iomanip>\n",
    "using namespace std;\n",
    "\n",
    "void luDecomposition(vector<vector<double>>& A) {\n",
    "    int n = A.size();\n",
    "\n",
    "    vector<vector<double>> L(n, vector<double>(n, 0));\n",
    "    vector<vector<double>> U(n, vector<double>(n, 0));\n",
    "\n",
    "    // Doolittle Method\n",
    "    for (int i = 0; i < n; i++) {\n",
    "\n",
    "        // Compute U\n",
    "        for (int k = i; k < n; k++) {\n",
    "            double sum = 0;\n",
    "\n",
    "            for (int j = 0; j < i; j++) {\n",
    "                sum += L[i][j] * U[j][k];\n",
    "            }\n",
    "\n",
    "            U[i][k] = A[i][k] - sum;\n",
    "        }\n",
    "\n",
    "        // Compute L\n",
    "        L[i][i] = 1;\n",
    "\n",
    "        for (int k = i + 1; k < n; k++) {\n",
    "            double sum = 0;\n",
    "\n",
    "            for (int j = 0; j < i; j++) {\n",
    "                sum += L[k][j] * U[j][i];\n",
    "            }\n",
    "\n",
    "            L[k][i] = (A[k][i] - sum) / U[i][i];\n",
    "        }\n",
    "    }\n",
    "\n",
    "    cout << \"L Matrix:\\n\";\n",
    "    for (auto& row : L) {\n",
    "        for (double x : row)\n",
    "            cout << setw(10) << fixed << setprecision(4) << x;\n",
    "        cout << endl;\n",
    "    }\n",
    "\n",
    "    cout << \"\\nU Matrix:\\n\";\n",
    "    for (auto& row : U) {\n",
    "        for (double x : row)\n",
    "            cout << setw(10) << fixed << setprecision(4) << x;\n",
    "        cout << endl;\n",
    "    }\n",
    "}\n",
    "\n",
    "int main() {\n",
    "\n",
    "    vector<vector<double>> A = {\n",
    "        {2, -1, -2},\n",
    "        {-4, 6, 3},\n",
    "        {-4, -2, 8}\n",
    "    };\n",
    "\n",
    "    luDecomposition(A);\n",
    "\n",
    "    return 0;\n",
    "}"
