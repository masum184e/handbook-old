    "Result:\n",
    "\n",
    "$$\n",
    "R_3\n",
    "=\\left[0,\\frac53,\\frac23,\\frac{13}{3}\\right]\n",
    "$$\n",
    "\n",
    "Matrix becomes:\n",
    "\n",
    "$$\n",
    "\\left[\n",
    "\\begin{array}{ccc|c}\n",
