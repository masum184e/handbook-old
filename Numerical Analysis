    "\n",
    "$$\n",
    "m_{ik}\n",
    "=\\frac{a_{ik}}{a_{kk}}\n",
    "$$\n",
    "\n",
    "Then:\n",
    "\n",
    "$$\n",
    "R_i\n",
    "=R_i-m_{ik}R_k\n",
    "$$\n",
