    "\n",
    "        for (int j = i + 1; j < n; j++) {\n",
    "            x[i] -= aug[i][j] * x[j];\n",
    "        }\n",
    "\n",
    "        x[i] /= aug[i][i];\n",
    "    }\n",
    "\n",
    "    return x;\n",
    "}\n",
