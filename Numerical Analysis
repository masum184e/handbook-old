    "%%writefile main.cpp\n",
    "\n",
    "#include <iostream>\n",
    "#include <vector>\n",
    "using namespace std;\n",
    "\n",
    "double newtonInterpolation(\n",
    "    vector<double> x,\n",
    "    vector<double> y,\n",
    "    double xp\n",
    ") {\n",
    "    int n = x.size();\n",
    "\n",
    "    vector<vector<double>> dd(n, vector<double>(n));\n",
    "\n",
    "    for (int i = 0; i < n; i++)\n",
    "        dd[i][0] = y[i];\n",
    "\n",
    "    for (int j = 1; j < n; j++) {\n",
    "        for (int i = 0; i < n - j; i++) {\n",
    "            dd[i][j] =\n",
    "                (dd[i + 1][j - 1] - dd[i][j - 1]) /\n",
    "                (x[i + j] - x[i]);\n",
    "        }\n",
    "    }\n",
    "\n",
    "    double result = dd[0][0];\n",
    "    double term = 1;\n",
    "\n",
    "    for (int i = 1; i < n; i++) {\n",
    "        term *= (xp - x[i - 1]);\n",
    "        result += term * dd[0][i];\n",
    "    }\n",
    "\n",
    "    return result;\n",
    "}\n",
    "\n",
    "int main() {\n",
    "    vector<double> x = {1, 2, 3};\n",
    "    vector<double> y = {1, 4, 9};\n",
    "\n",
    "    double xp = 2.5;\n",
    "\n",
    "    cout << \"Interpolated value = \"\n",
    "         << newtonInterpolation(x, y, xp)\n",
    "         << endl;\n",
    "\n",
    "    return 0;\n",
    "}"
