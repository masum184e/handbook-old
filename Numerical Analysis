    "\n",
    "#include <iostream>\n",
    "#include <cmath>\n",
    "using namespace std;\n",
    "\n",
    "// Example function: f(x) = x^3 - x - 2\n",
    "double f(double x) {\n",
    "    return x * x * x - x - 2;\n",
    "}\n",
    "\n",
    "double falsePosition(double a, double b, double tol = 1e-6, int maxIter = 1000) {\n",
    "    if (f(a) * f(b) >= 0) {\n",
    "        throw invalid_argument(\"f(a) and f(b) must have opposite signs\");\n",
    "    }\n",
    "\n",
    "    double c;\n",
    "\n",
    "    for (int i = 0; i < maxIter; i++) {\n",
    "        c = (a * f(b) - b * f(a)) / (f(b) - f(a));\n",
    "\n",
    "        if (fabs(f(c)) < tol)\n",
    "            return c;\n",
    "\n",
    "        if (f(a) * f(c) < 0)\n",
    "            b = c;\n",
    "        else\n",
    "            a = c;\n",
    "    }\n",
    "\n",
    "    return c;\n",
    "}\n",
