    "\n",
    "#include <iostream>\n",
    "#include <vector>\n",
    "#include <cmath>\n",
    "using namespace std;\n",
    "\n",
    "vector<double> partialPivotingGaussian(vector<vector<double>> aug) {\n",
    "    int n = aug.size();\n",
    "\n",
    "    // Forward Elimination\n",
    "    for (int i = 0; i < n - 1; i++) {\n",
    "\n",
    "        // Find row with largest absolute value in current column\n",
    "        int maxRow = i;\n",
    "        for (int k = i + 1; k < n; k++) {\n",
    "            if (fabs(aug[k][i]) > fabs(aug[maxRow][i])) {\n",
    "                maxRow = k;\n",
    "            }\n",
    "        }\n",
    "\n",
    "        // Swap rows if needed\n",
    "        if (maxRow != i) {\n",
    "            swap(aug[i], aug[maxRow]);\n",
    "        }\n",
    "\n",
    "        // Check for zero pivot\n",
    "        if (fabs(aug[i][i]) < 1e-10) {\n",
    "            throw runtime_error(\"No unique solution exists.\");\n",
    "        }\n",
    "\n",
    "        // Eliminate entries below pivot\n",
    "        for (int k = i + 1; k < n; k++) {\n",
    "            double factor = aug[k][i] / aug[i][i];\n",
    "\n",
    "            for (int j = i; j <= n; j++) {\n",
    "                aug[k][j] -= factor * aug[i][j];\n",
    "            }\n",
    "        }\n",
    "    }\n",
    "\n",
