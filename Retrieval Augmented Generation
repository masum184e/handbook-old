34.359502Z","iopub.status.idle":"2026-11-23T06:10:34.614487Z","shell.execute_reply":"2026-11-23T06:10:34.61346Z"},"papermill":{"duration":0.269147,"end_time":"2026-11-23T06:10:34.616908+00:00","exception":false,"start_time":"2026-11-23T06:10:34.347761+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["/tmp/ipykernel_16/3167814943.py:1: DeprecationWarning: `langchain-community` is being sunset and is no longer actively maintained. See https://github.com/langchain-ai/langchain-community/issues/674 for details and migration guidance toward standalone integration packages.\n","  from langchain_community.vectorstores import FAISS\n"]}],"source":["from langchain_community.vectorstores import FAISS\n","\n","vectorstore = FAISS.from_documents(\n","    documents=documents,\n","    embedding=embeddings\n",")"]},{"cell_type":"markdown","id":"ca37d8dd","metadata":{"papermill":{"duration":0.010196,"end_time":"2026-11-23T06:10:34.637301+00:00","exception":false,"start_time":"2026-11-23T06:10:34.627105+00:00","status":"completed"},"tags":[]},"source":["\n","# Reranking\n","\n","Reranking is the process of taking an initial list of retrieved documents and reordering them based on how relevant they are to the user's query.\n","\n","A vector database usually retrieves documents based on embedding similarity. However, the documents with the highest vector similarity are not always the documents that best answer the question.\n","\n","Reranking uses a more sophisticated relevance model to evaluate the relationship between the query and each retrieved document.\n","\n","Suppose a user asks:\n","\n","> How can I reduce memory usage in a Python application?\n","\n","A vector database retrieves these 5 documents:\n","\n","| Document                         | Initial vector similarity |\n","| -------------------------------- | ------------------------- |\n","| Doc A: Python memory profiling   | 0.89                      |\n","| Doc B: Memory management in Java | 0.86                      |\n","| Doc C: Python garbage collection | 0.83                      |\n","| Doc D: Python list optimization  | 0.81                      |\n","| Doc E: Computer RAM hardware     | 0.79                      |\n","\n","The vector database ranked them based on embedding similarity.\n","\n","But the user specifically asked about Python memory usage.\n","\n","A reranker may produce the following ranking:\n","\n","| Document                         | Reranker score | New rank |\n","| -------------------------------- | -------------- | -------- |\n","| Doc A: Python memory profiling   | 0.97           | 1        |\n","| Doc C: Python garbage collection | 0.94           | 2        |\n","| Doc D: Python list optimization  | 0.91           | 3        |\n","| Doc B: Memory management in Java | 0.24           | 4        |\n","| Doc E: Computer RAM hardware     | 0.08           | 5        |\n","\n","The reranker moves the most relevant documents to the top.\n","\n","The key distinction:\n","\n","- Vector retrieval: Quickly finds potentially relevant documents.\n","- Reranking: More accurately determines which retrieved documents are most relevant.\n","\n","## Problem Statement\n","\n","To understand the need for reranking, first understand the limitations of vector search.\n","\n","### Problem 1: Embedding similarity is not perfect relevance\n","\n","An embedding model converts text into a vector.\n","\n","For example:\n","\n","```\n","query = \"How to train a neural network?\"\n","```\n","\n","The embedding model may generate:\n","\n","$$ q = [0.12, 0.45, 0.78, 0.21, \\ldots] $$\n","\n","A document gets its own embedding:\n","\n","$$ d = [0.15, 0.43, 0.80, 0.19, \\ldots] $$\n","\n","We calculate cosine similarity:\n","\n","$$ \\text{Cosine Similarity}(q,d) = \\frac{q \\cdot d}{\\\\|q\\\\|\\\\|d\\\\|} $$\n","\n","If the similarity is high, the document is considered semantically similar.\n","\n","But semantic similarity is not necessarily the same as answering the user's question.\n","\n","For example:\n","\n","Query:\n","\n","> Does Python support multithreading?\n","\n","Document A:\n","\n","> Python supports multithreading, but the Global Interpreter Lock limits parallel execution of Python bytecode in standard CPython builds.\n","\n","Document B:\n","\n","> Python is a popular programming language used for machine learning, web development, and automation.\n","\n","Both documents might be semantically similar to the query, but Document A is much more useful.\n","\n","A reranker can better distinguish these two documents.\n","\n","### Problem 2: Embeddings compress information\n","\n","Embedding models convert a large amount of textual information into a fixed-dimensional vector.\n","\n","This process can lose some fine-grained information, such as:\n","\n","- Exact relationships between query terms.\n","- Negation.\n","- Specific constraints.\n","- Contextual details.\n","- Whether a document directly answers a question.\n","\n","Reranking helps recover relevance distinctions by evaluating the original text, rather than relying solely on compressed vector representations.\n","\n","### Problem 3: ANN retrieval prioritizes speed\n","\n","Approximate Nearest Neighbor algorithms, such as HNSW and IVF, are designed to find good candidates efficiently. They may not return the globally most relevant candidates in exact order. But it helps refine the ordering of the candidate documents.\n","\n","However, an important limitation:\n","\n","- Reranking cannot recover a relevant document that was never retrieved in the initial retrieval stage.\n","\n","That is why retrieval recall and reranking quality are both important.\n","\n","## Inside Reranker\n","\n","There are different reranking methods, but the most commonly used neural reranker is the Cross-Encoder.\n","\n","To understand it, let's compare two architectures:\n","\n","1. Bi-Encoder (used for embedding-based retrieval)\n","2. Cross-Encoder (commonly used for reranking)\n","\n","###  Bi-Encoder\n","\n","A bi-encoder processes the query and document independently.\n","\n","![Bi Encoder](https://raw.githubusercontent.com/masum184e/handbook/main/static/img/ai-engineering/bi_encoder.png)"]},{"cell_type":"code","execution_count":18,"id":"ba58bb05","metadata":{"execution":{"iopub.execute_input":"2026-11-23T06:10:34.659645Z","iopub.status.busy":"2026-11-23T06:10:34.659242Z","iopub.status.idle":"2026-11-23T06:10:34.664766Z","shell.execute_reply":"2026-11-23T06:10:34.66378Z"},"papermill":{"duration":0.019175,"end_time":"2026-11-23T06:10:34.666898+00:00","exception":false,"start_time":"2026-11-23T06:10:34.647723+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["candidate_documents = [\n","    \"Machine learning is a branch of artificial intelligence.\",\n","    \"Deep learning uses neural networks with multiple layers.\",\n","    \"Python is a popular programming language.\",\n","    \"Machine learning enables computers to learn from data.\",\n","    \"Natural language processing deals with human language.\"\n","]\n","query = \"What is machine learning?\""]},{"cell_type":"code","execution_count":19,"id":"7183b052","metadata":{"execution":{"iopub.execute_input":"2026-11-23T06:10:34.690993Z","iopub.status.busy":"2026-11-23T06:10:34.690588Z","iopub.status.idle":"2026-11-23T06:10:36.682899Z","shell.execute_reply":"2026-11-23T06:10:36.681788Z"},"papermill":{"duration":2.007999,"end_time":"2026-11-23T06:10:36.684988+00:00","exception":false,"start_time":"2026-11-23T06:10:34.676989+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"5fa6017c3d074506a3d6e4e51d3e67b2","version_major":2,"version_minor":0},"text/plain":["Loading weights:   0%|          | 0/103 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"}],"source":["from sentence_transformers import SentenceTransformer\n","\n","# Load a pretrained embedding model\n","bi_encoder 